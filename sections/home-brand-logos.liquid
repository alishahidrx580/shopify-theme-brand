{% schema %}
{
  "name": "Brand Logos Strip",
  "tag": "section",
  "class": "home-brand-logos",
  "settings": [
    {
      "type": "range",
      "id": "scroll_seconds",
      "label": "Scroll duration (seconds)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Brand logo image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Brand name",
          "info": "Used as alt text and as a fallback if no logo is uploaded",
          "default": "Brand Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)",
          "info": "e.g. link to /collections/brand-handle"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Brand Logos Strip",
      "blocks": [
        { "type": "brand", "settings": { "name": "La Roche-Posay" } },
        { "type": "brand", "settings": { "name": "CeraVe" } },
        { "type": "brand", "settings": { "name": "Aveeno" } },
        { "type": "brand", "settings": { "name": "Avène" } },
        { "type": "brand", "settings": { "name": "COSRX" } },
        { "type": "brand", "settings": { "name": "ACM" } },
        { "type": "brand", "settings": { "name": "Dermalogica" } },
        { "type": "brand", "settings": { "name": "ISDIN" } },
        { "type": "brand", "settings": { "name": "Medicube" } },
        
        
      ]
    }
  ]
}
{% endschema %}

<style>
  .home-brand-logos {
    background: #FFFFFF;
    padding: 40px 0;
    overflow: hidden;
  }
  .home-brand-logos__track-wrapper {
    overflow: hidden;
  }
  .home-brand-logos__track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: brandMarquee var(--brand-scroll-duration, 20s) linear 1s infinite;
    animation-play-state: running;
  }
  .home-brand-logos[data-pause-hover="true"] .home-brand-logos__track:hover,
  .home-brand-logos[data-pause-hover="true"] .home-brand-logos__track:focus-within {
    animation-play-state: paused;
  }
  @keyframes brandMarquee {
    0%   { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }
  .home-brand-logos__item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 180px;
    height: 90px;
    padding: 0 24px;
  }
  .home-brand-logos__item img {
    max-width: 100%;
    max-height: 56px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .home-brand-logos__item--text {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(11,31,58,0.4);
    white-space: nowrap;
  }
  .home-brand-logos__item:focus-visible {
    outline: 2px solid #0B1F3A;
    outline-offset: 2px;
  }
</style>

{%- assign scroll_dur = section.settings.scroll_seconds | default: 20 -%}

<div
  class="home-brand-logos"
  data-pause-hover="{{ section.settings.pause_on_hover }}"
>
  <div class="home-brand-logos__track-wrapper">
    <div class="home-brand-logos__track" style="--brand-scroll-duration: {{ scroll_dur }}s;">
      {%- comment -%} First pass {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="home-brand-logos__item{% unless block.settings.logo %} home-brand-logos__item--text{% endunless %}" {{ block.shopify_attributes }}>
        {%- else -%}<span class="home-brand-logos__item{% unless block.settings.logo %} home-brand-logos__item--text{% endunless %}" {{ block.shopify_attributes }}>
        {%- endif -%}
          {%- if block.settings.logo -%}
            <img
              srcset="{{ block.settings.logo | image_url: width: 180 }} 1x, {{ block.settings.logo | image_url: width: 360 }} 2x"
              src="{{ block.settings.logo | image_url: width: 180 }}"
              alt="{{ block.settings.name | escape }}"
              loading="lazy"
              width="180"
              height="90"
            >
          {%- else -%}
            {{ block.settings.name }}
          {%- endif -%}
        {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
      {%- endfor -%}
      {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
      {%- for block in section.blocks -%}
        <span class="home-brand-logos__item{% unless block.settings.logo %} home-brand-logos__item--text{% endunless %}" aria-hidden="true" tabindex="-1">
          {%- if block.settings.logo -%}
            <img src="{{ block.settings.logo | image_url: width: 180 }}" alt="" loading="lazy" width="180" height="90">
          {%- else -%}
            {{ block.settings.name }}
          {%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>