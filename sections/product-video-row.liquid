{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign ratio = section.settings.ratio
-%}

<style>
#shopify-section-{{ section.id }}{--pvm-per:{{ section.settings.per_view }};--pvm-gap:14px;--pvm-nav:{{ section.settings.nav_colour }};}
#shopify-section-{{ section.id }} .pvm{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;}
#shopify-section-{{ section.id }} .pvm__head{margin:0 0 14px;}
#shopify-section-{{ section.id }} .pvm__heading{margin:6px 0 0;font-size:clamp(1.25rem,2.2vw,1.75rem);line-height:1.2;}
#shopify-section-{{ section.id }} .pvm__viewport{position:relative;}
#shopify-section-{{ section.id }} .pvm__track{display:flex;gap:var(--pvm-gap);overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;-ms-overflow-style:none;}
#shopify-section-{{ section.id }} .pvm__track::-webkit-scrollbar{display:none;}
#shopify-section-{{ section.id }} .pvm__card{flex:0 0 calc((100% - (var(--pvm-per) - 1) * var(--pvm-gap)) / var(--pvm-per));scroll-snap-align:start;position:relative;}
#shopify-section-{{ section.id }} .pvm__media{position:relative;aspect-ratio:{{ ratio }};border-radius:3px;overflow:hidden;background:rgba(0,0,0,.06);}
#shopify-section-{{ section.id }} .pvm__media video,#shopify-section-{{ section.id }} .pvm__media img,#shopify-section-{{ section.id }} .pvm__media iframe{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;border:0;}
#shopify-section-{{ section.id }} .pvm__ph{position:absolute;inset:0;display:grid;place-items:center;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;opacity:.45;text-align:center;padding:12px;}
#shopify-section-{{ section.id }} .pvm__cap{margin:8px 0 0;font-size:.8rem;line-height:1.35;opacity:.8;}
#shopify-section-{{ section.id }} .pvm__sound{position:absolute;right:8px;bottom:8px;width:30px;height:30px;border-radius:50%;border:0;cursor:pointer;background:rgba(0,0,0,.45);color:#fff;display:grid;place-items:center;padding:0;}
#shopify-section-{{ section.id }} .pvm__sound svg{width:15px;height:15px;}
#shopify-section-{{ section.id }} .pvm__sound .pvm__on{display:none;}
#shopify-section-{{ section.id }} .pvm__sound.is-on .pvm__on{display:block;}
#shopify-section-{{ section.id }} .pvm__sound.is-on .pvm__off{display:none;}
#shopify-section-{{ section.id }} .pvm__nav{position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;border:0;cursor:pointer;background:var(--pvm-nav);color:#fff;display:grid;place-items:center;z-index:2;padding:0;transition:opacity .2s ease;}
#shopify-section-{{ section.id }} .pvm__nav svg{width:16px;height:16px;}
#shopify-section-{{ section.id }} .pvm__nav--prev{left:-12px;}
#shopify-section-{{ section.id }} .pvm__nav--next{right:-12px;}
@media (max-width:749px){
#shopify-section-{{ section.id }}{--pvm-per:{{ section.settings.per_view_mobile }};--pvm-gap:10px;}
#shopify-section-{{ section.id }} .pvm__nav--prev{left:-6px;}
#shopify-section-{{ section.id }} .pvm__nav--next{right:-6px;}
}
@media (prefers-reduced-motion:reduce){#shopify-section-{{ section.id }} .pvm__track{scroll-behavior:auto;}}
</style>

<section class="pvm full-width">
  <div class="pvm__inner cham-container">
    {%- if eyebrow != blank or heading != blank -%}
      <div class="pvm__head" data-reveal>
        {%- if eyebrow != blank -%}<span class="eyebrow">{{ eyebrow }}</span>{%- endif -%}
        {%- if heading != blank -%}<h2 class="pvm__heading font-display">{{ heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="pvm__viewport">
      <button type="button" class="pvm__nav pvm__nav--prev" aria-label="Previous videos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>

      <div class="pvm__track">
        {%- for block in section.blocks -%}
          <div class="pvm__card" {{ block.shopify_attributes }}>
            <div class="pvm__media">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: image_size: '600x', autoplay: true, loop: true, muted: true, controls: false }}
                {%- if section.settings.show_sound -%}
                  <button type="button" class="pvm__sound" aria-pressed="false" aria-label="Turn sound on or off">
                    <svg class="pvm__off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
                    <svg class="pvm__on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.5 8.5a5 5 0 0 1 0 7"></path><path d="M18.5 5.5a9 9 0 0 1 0 13"></path></svg>
                  </button>
                {%- endif -%}
              {%- elsif block.settings.video_url != blank -%}
                {{ block.settings.video_url | external_video_url: autoplay: 1, loop: 1, mute: 1, controls: 0 | external_video_tag }}
              {%- elsif block.settings.poster != blank -%}
                <img src="{{ block.settings.poster | image_url: width: 600 }}" alt="{{ block.settings.caption | escape }}" loading="lazy" width="600" height="1067">
              {%- else -%}
                <span class="pvm__ph">Add a video in the theme editor</span>
              {%- endif -%}
            </div>
            {%- if block.settings.caption != blank -%}<p class="pvm__cap">{{ block.settings.caption }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <button type="button" class="pvm__nav pvm__nav--next" aria-label="More videos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
    </div>
  </div>
</section>

<script>
(function(){
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root) return;
  var track = root.querySelector('.pvm__track');
  if (!track) return;
  var prev = root.querySelector('.pvm__nav--prev');
  var next = root.querySelector('.pvm__nav--next');
  var vids = Array.prototype.slice.call(root.querySelectorAll('video'));
  var btns = Array.prototype.slice.call(root.querySelectorAll('.pvm__sound'));

  function step(){
    var card = track.querySelector('.pvm__card');
    if (!card) return 280;
    var gap = parseFloat(getComputedStyle(track).columnGap) || 14;
    return card.getBoundingClientRect().width + gap;
  }

  function sync(){
    var max = track.scrollWidth - track.clientWidth;
    var scrollable = max > 4;
    if (prev) { prev.style.display = scrollable ? '' : 'none'; prev.style.opacity = track.scrollLeft <= 4 ? '0.35' : '1'; }
    if (next) { next.style.display = scrollable ? '' : 'none'; next.style.opacity = track.scrollLeft >= max - 4 ? '0.35' : '1'; }
  }

  if (prev) prev.addEventListener('click', function(){ track.scrollBy({ left: -step(), behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function(){ track.scrollBy({ left: step(), behavior: 'smooth' }); });
  track.addEventListener('scroll', sync);
  window.addEventListener('resize', sync);
  sync();

  vids.forEach(function(v){
    v.muted = true;
    v.defaultMuted = true;
    v.loop = true;
    v.controls = false;
    v.preload = 'metadata';
    v.playsInline = true;
    v.setAttribute('muted', '');
    v.setAttribute('playsinline', '');
  });

  if (window.IntersectionObserver) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        var v = e.target;
        if (e.isIntersecting) { var p = v.play(); if (p && p.catch) p.catch(function(){}); }
        else { v.pause(); }
      });
    }, { threshold: 0.3 });
    vids.forEach(function(v){ io.observe(v); });
  } else {
    vids.forEach(function(v){ var p = v.play(); if (p && p.catch) p.catch(function(){}); });
  }

  btns.forEach(function(btn){
    btn.addEventListener('click', function(){
      var card = btn.closest('.pvm__card');
      var v = card ? card.querySelector('video') : null;
      if (!v) return;
      var turningOn = v.muted;
      vids.forEach(function(o){ o.muted = true; });
      btns.forEach(function(b){ b.classList.remove('is-on'); b.setAttribute('aria-pressed', 'false'); });
      if (turningOn) {
        v.muted = false;
        btn.classList.add('is-on');
        btn.setAttribute('aria-pressed', 'true');
        var p = v.play();
        if (p && p.catch) p.catch(function(){});
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "See it in motion",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "See it in motion" },
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "range", "id": "per_view", "label": "Videos visible (desktop)", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "range", "id": "per_view_mobile", "label": "Videos visible (mobile)", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "select", "id": "ratio", "label": "Video shape", "options": [ { "value": "9/16", "label": "Vertical 9:16" }, { "value": "3/4", "label": "Portrait 3:4" }, { "value": "1/1", "label": "Square" } ], "default": "9/16" },
    { "type": "checkbox", "id": "show_sound", "label": "Show sound button", "default": true },
    { "type": "color", "id": "nav_colour", "label": "Arrow colour", "default": "#8a6a2f" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (upload or choose from Files)" },
        { "type": "video_url", "id": "video_url", "label": "Or paste a YouTube or Vimeo link", "accept": ["youtube", "vimeo"] },
        { "type": "image_picker", "id": "poster", "label": "Cover image (shown if there is no video)" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "See it in motion", "blocks": [ { "type": "video" }, { "type": "video" }, { "type": "video" } ] }
  ]
}
{% endschema %}
