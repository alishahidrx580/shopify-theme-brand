<section class="home-featured full-width">
  <div class="home-featured__inner cham-container">
    <div class="home-featured__head">
      <div data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="home-featured__heading font-display">
          {{- section.settings.heading_lead -}}
          {%- if section.settings.heading_emphasis != blank %} <em>{{ section.settings.heading_emphasis }}</em>{%- endif -%}
        </h2>
      </div>
      {%- if section.settings.view_all_label != blank -%}
        <a href="{{ section.settings.view_all_url | default: routes.all_products_collection_url }}" class="home-featured__view-all gold-link" data-reveal>
          {{ section.settings.view_all_label | strip | remove_last: "→" | strip }} →
        </a>
      {%- endif -%}
    </div>

    <div class="home-featured__rail">
    <div class="home-featured__grid">
      {%- assign limit = section.settings.products_to_show -%}
      {%- assign products_collection = section.settings.collection -%}

      {%- assign source = blank -%}
      {%- if products_collection.products_count > 0 -%}
        {%- assign source = products_collection.products -%}
      {%- elsif collections.all.products.size > 0 -%}
        {%- assign source = collections.all.products -%}
      {%- endif -%}

      {%- if source != blank -%}
        {%- for product in source limit: limit -%}
          <div data-reveal data-reveal-delay="{{ forloop.index0 | times: 100 }}">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div data-reveal data-reveal-delay="{{ forloop.index0 | times: 100 }}">
            {% render 'product-card', placeholder: true, index: i %}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <button type="button" class="hf-nav hf-nav--prev" aria-label="Previous products" data-hf-prev>
        <svg viewBox="0 0 12 18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 1L2 9l8 8"/></svg>
      </button>
      <button type="button" class="hf-nav hf-nav--next" aria-label="Next products" data-hf-next>
        <svg viewBox="0 0 12 18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 1l8 8-8 8"/></svg>
      </button>
    </div>
  </div>
</section>
<script>
  (function () {
    if (window.__hfRailInit) return;
    window.__hfRailInit = true;
    function wire(root) {
      (root || document).querySelectorAll(".home-featured").forEach(function (sec) {
        if (sec.dataset.hfWired) return;
        var rail = sec.querySelector(".home-featured__grid");
        var prev = sec.querySelector("[data-hf-prev]");
        var next = sec.querySelector("[data-hf-next]");
        if (!rail || !prev || !next) return;
        sec.dataset.hfWired = "1";
        function step() {
          var c = rail.firstElementChild;
          return c ? (c.getBoundingClientRect().width + 8) * 2 : 440;
        }
        function update() {
          var max = rail.scrollWidth - rail.clientWidth;
          sec.classList.toggle("hf--fits", max <= 2);
          prev.disabled = rail.scrollLeft <= 2;
          next.disabled = rail.scrollLeft >= max - 2;
        }
        prev.addEventListener("click", function () { rail.scrollBy({ left: -step(), behavior: "smooth" }); });
        next.addEventListener("click", function () { rail.scrollBy({ left: step(), behavior: "smooth" }); });
        rail.addEventListener("scroll", update, { passive: true });
        if (window.ResizeObserver) { new ResizeObserver(update).observe(rail); }
        update();
      });
    }
    if (document.readyState === "loading") { document.addEventListener("DOMContentLoaded", function () { wire(); }); } else { wire(); }
    document.addEventListener("shopify:section:load", function (e) { wire(e.target); });
  })();
</script>

{% stylesheet %}
  .home-featured {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .home-featured__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 4rem;
    gap: 2rem;
  }

  .home-featured__heading {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.05;
    margin-top: 1rem;
  }

  .home-featured__heading em {
    color: var(--primary);
    font-style: italic;
  }

  .home-featured__view-all {
    display: none;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.75rem;
    color: color-mix(in oklab, var(--foreground) 90%, transparent);
    transition: color 0.3s ease;
  }

  .home-featured__view-all:hover {
    color: var(--primary);
  }

  @media (min-width: 1024px) {
    .home-featured__view-all {
      display: inline-block;
    }
  }

  .home-featured__grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 2rem;
    row-gap: 4rem;
  }

  @media (min-width: 768px) {
    .home-featured__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .home-featured__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* === SEPHORA-GRADE POLISH (start) — delete this block to revert === */
  .home-featured {
    padding-block: 40px 48px;
  }

  .home-featured__head {
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 20px;
  }

  .home-featured__head .eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    opacity: 0.6;
  }

  .home-featured__heading,
  .home-featured__heading.font-display {
    font-size: clamp(1.375rem, 2vw, 1.625rem);
    line-height: 1.22;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 4px;
  }

  .home-featured__view-all,
  .home-featured__view-all.gold-link {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .home-featured__view-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .home-featured__grid {
    gap: 32px 20px;
  }

  @media (min-width: 600px) {
    .home-featured__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .home-featured__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (min-width: 1500px) {
    .home-featured__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
    .home-featured__rail { position: relative; }
  .home-featured__grid { display: flex; gap: 8px; overflow: auto hidden; scrollbar-width: none; scroll-snap-type: x mandatory; scroll-behavior: smooth; }
  .home-featured__grid::-webkit-scrollbar { display: none; }
  .home-featured__grid > * { flex: 0 0 220px; scroll-snap-align: start; }
  .hf-nav { position: absolute; top: 110px; transform: translateY(-50%); width: 48px; height: 48px; border: 0; border-radius: 50%; background: #fff; color: #000; box-shadow: 0 1px 6px rgba(0,0,0,.28); cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; z-index: 3; }
  .hf-nav svg { width: 12px; height: 18px; }
  .hf-nav--prev { left: -10px; }
  .hf-nav--next { right: -10px; }
  .hf-nav[disabled] { opacity: 0; pointer-events: none; }
  .home-featured.hf--fits .hf-nav { display: none; }
  @media (max-width: 749px) { .hf-nav { display: none; } .home-featured__grid > * { flex: 0 0 160px; } }
  /* --- Sephora rail geometry (measured from sephora.com) --- */
  .home-featured__grid { gap: 12px; padding-block: 8px 12px; }
  .home-featured__grid > * { flex: 0 0 198px; }
  .hf-nav { top: 107px; }
  @media (max-width: 749px) { .home-featured__grid > * { flex: 0 0 160px; } }
/* === SEPHORA-GRADE POLISH (end) === */

{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home_featured_products.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "The Edit"
    },
    {
      "type": "text",
      "id": "heading_lead",
      "label": "t:labels.heading_lead",
      "default": "Hero"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "t:labels.heading_emphasis",
      "default": "formulations"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection",
      "info": "If empty or has no products, placeholder cards will be shown."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:labels.view_all_label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "t:labels.view_all_url"
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_featured_products.presets_default"
    }
  ]
}
{% endschema %}
