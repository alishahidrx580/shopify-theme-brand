<section class="brand-strip" aria-label="Shop by brand">
{%- if section.settings.heading != blank -%}
<header class="brand-strip__head">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}<h2 class="brand-strip__title">{{ section.settings.heading }}</h2></header>
{%- endif -%}
<div class="brand-strip__track">
{%- for block in section.blocks -%}
{%- assign bp = block.settings.product -%}
<a class="brand-strip__item" href="{{ routes.root_url }}collections/vendors?q={{ block.settings.name | url_encode }}" style="--brand-color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
<span class="brand-strip__media">{%- if bp != blank and bp.featured_image -%}{{ bp.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 15vw, 45vw', alt: block.settings.name }}{%- endif -%}</span>
<span class="brand-strip__label">{{ block.settings.name }}</span>
</a>
{%- endfor -%}
</div>
</section>

<style>
.brand-strip{padding:56px 0 64px}
.brand-strip__head{padding:0 24px;margin-bottom:28px}
.brand-strip__title{margin:.2em 0 0}
.brand-strip__track{display:flex;height:500px;background:#f1f1f1;overflow:hidden}
.brand-strip__item{position:relative;flex:1 1 0;min-width:0;display:flex;flex-direction:column;text-decoration:none;color:#fff;background:#f1f1f1;transition:background .3s ease}
.brand-strip__media{flex:1;display:flex;align-items:center;justify-content:center;padding:0;min-height:0;overflow:hidden}
.brand-strip__media img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transform:scale(1.6);transition:transform .35s ease}
.brand-strip__label{display:flex;align-items:center;justify-content:center;height:52px;padding:0 8px;background:var(--brand-color);color:#fff;font-size:14px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;text-align:center}
.brand-strip__track:not(:hover) .brand-strip__item:first-child,.brand-strip__item:hover,.brand-strip__item:focus-visible{background:color-mix(in srgb,var(--brand-color) 32%,#fff)}
.brand-strip__item:hover img,.brand-strip__item:focus-visible img{transform:scale(1.78)}
@media (max-width:749px){
.brand-strip{padding:36px 0 44px}
.brand-strip__head{padding:0 16px;margin-bottom:20px}
.brand-strip__track{height:340px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.brand-strip__track::-webkit-scrollbar{display:none}
.brand-strip__item,.brand-strip__track:not(:hover) .brand-strip__item:first-child{flex:0 0 38vw;scroll-snap-align:start;background:color-mix(in srgb,var(--brand-color) 14%,#fff)}
.brand-strip__item:active{background:var(--brand-color)}
}
</style>

{% schema %}
{"name":"Shop by brand","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by brand"},{"type":"text","id":"heading","label":"Heading","default":"Find your favourite brand"}],"blocks":[{"type":"brand","name":"Brand","settings":[{"type":"text","id":"name","label":"Brand name (must match the product vendor exactly)"},{"type":"color","id":"color","label":"Brand colour","default":"#0b2a5b"},{"type":"product","id":"product","label":"Product image"}]}],"presets":[{"name":"Shop by brand"}]}
{% endschema %}
