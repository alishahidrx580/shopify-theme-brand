<section class="brand-strip" aria-label="Shop by brand">
{%- if section.settings.heading != blank -%}
<header class="brand-strip__head">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}<h2 class="brand-strip__title">{{ section.settings.heading }}</h2></header>
{%- endif -%}
<div class="brand-strip__rail">
<div class="brand-strip__track" data-brand-track>
{%- for block in section.blocks -%}
{%- assign bp = block.settings.product -%}
{%- comment -%}
  Prefer the brand's own collection. Each brand now has an automated
  collection keyed on Vendor, so /collections/cerave is a real indexable page
  with its own title, description and schema, instead of the filtered
  /collections/vendors?q= view.

  The query view is kept as a fallback for any brand that has no collection
  yet, so adding a block here never produces a dead link. That fallback still
  needs its own two fixes, both confirmed against the live site:

  1. url_encode renders spaces as "+", and Shopify's robots.txt disallows
     /collections/*+*, so multi-word brands were blocked to crawlers.
  2. Shopify lowercases the canonical on those pages, so ?q=CeraVe was always
     a "canonicalised" URL. downcase runs after url_encode so it also
     lowercases the percent-encoding's hex digits, which Avene needs.
{%- endcomment -%}
{%- liquid
  assign vendor_query = block.settings.name | url_encode | downcase | replace: '+', '%20'
  assign brand_handle = block.settings.name | handle
  assign brand_collection = collections[brand_handle]

  if brand_collection != blank and brand_collection.products_count > 0
    assign brand_url = brand_collection.url
  else
    assign brand_url = routes.root_url | append: 'collections/vendors?q=' | append: vendor_query
  endif
-%}
<a class="brand-strip__item" href="{{ brand_url }}" style="--brand-color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
{%- comment -%}
  Empty alt on purpose. The brand name is already in the visible label below,
  inside the same link, so alt text repeating it makes a screen reader announce
  the brand twice for one link.
{%- endcomment -%}
<span class="brand-strip__media">{%- if bp != blank and bp.featured_image -%}{{ bp.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 15vw, 45vw', alt: '' }}{%- endif -%}</span>
<span class="brand-strip__label">{{ block.settings.name }}</span>
</a>
{%- endfor -%}
</div>
{%- comment -%}
  On mobile the track scrolls but gives no visual cue that it does, so the
  only way to reach brands past the second one was to guess and drag. These
  match the arrows on the product rails.
{%- endcomment -%}
<button type="button" class="brand-strip__nav brand-strip__nav--prev" aria-label="Previous brands" data-brand-prev>
  <svg viewBox="0 0 12 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 1L2 9l8 8"/></svg>
</button>
<button type="button" class="brand-strip__nav brand-strip__nav--next" aria-label="Next brands" data-brand-next>
  <svg viewBox="0 0 12 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 1l8 8-8 8"/></svg>
</button>
</div>
</section>

<script>
  (function () {
    document.querySelectorAll('.brand-strip').forEach(function (sec) {
      if (sec.dataset.brandWired) return;
      var rail = sec.querySelector('[data-brand-track]');
      var prev = sec.querySelector('[data-brand-prev]');
      var next = sec.querySelector('[data-brand-next]');
      if (!rail || !prev || !next) return;
      sec.dataset.brandWired = '1';
      function step() {
        var c = rail.firstElementChild;
        return c ? c.getBoundingClientRect().width * 2 : 320;
      }
      function update() {
        var max = rail.scrollWidth - rail.clientWidth;
        sec.classList.toggle('brand--fits', max <= 2);
        prev.disabled = rail.scrollLeft <= 2;
        next.disabled = rail.scrollLeft >= max - 2;
      }
      prev.addEventListener('click', function () { rail.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { rail.scrollBy({ left: step(), behavior: 'smooth' }); });
      rail.addEventListener('scroll', update, { passive: true });
      if (window.ResizeObserver) { new ResizeObserver(update).observe(rail); }
      update();
    });
  })();
</script>

<style>
.brand-strip{padding:56px 0 64px}
.brand-strip__head{padding:0 24px;margin-bottom:28px}
.brand-strip__title{margin:.2em 0 0}
.brand-strip__rail{position:relative}
.brand-strip__track{display:flex;height:500px;background:#f1f1f1;overflow:hidden}
.brand-strip__nav{display:none}
.brand-strip.brand--fits .brand-strip__nav{display:none}
.brand-strip__item{position:relative;flex:1 1 0;min-width:0;display:flex;flex-direction:column;text-decoration:none;color:#fff;background:#f1f1f1;transition:background .3s ease}
.brand-strip__media{flex:1;display:flex;align-items:center;justify-content:center;padding:0;min-height:0;overflow:hidden}
.brand-strip__media img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transform:scale(1.6);transition:transform .35s ease}
.brand-strip__label{display:flex;align-items:center;justify-content:center;height:52px;padding:0 8px;background:var(--brand-color);color:#fff;font-size:14px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;text-align:center}
.brand-strip__track:not(:hover) .brand-strip__item:first-child,.brand-strip__item:hover,.brand-strip__item:focus-visible{background:color-mix(in srgb,var(--brand-color) 32%,#fff)}
.brand-strip__item:hover img,.brand-strip__item:focus-visible img{transform:scale(1.78)}
@media (max-width:749px){
.brand-strip{padding:36px 0 44px}
.brand-strip__head{padding:0 16px;margin-bottom:20px}
.brand-strip__track{height:340px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.brand-strip__track::-webkit-scrollbar{display:none}
.brand-strip__item,.brand-strip__track:not(:hover) .brand-strip__item:first-child{flex:0 0 38vw;scroll-snap-align:start;background:color-mix(in srgb,var(--brand-color) 14%,#fff)}
.brand-strip__item:active{background:var(--brand-color)}
}
/* === SEPHORA-GRADE POLISH (start) — delete this block to revert === */
.brand-strip{padding:40px 0 48px}
.brand-strip__head{padding:0;margin-bottom:20px}
.brand-strip__head .eyebrow{font-size:11px;font-weight:600;letter-spacing:.16em;opacity:.6}
.brand-strip__title{font-size:clamp(1.375rem,2vw,1.625rem);line-height:1.22;font-weight:700;letter-spacing:-.01em;margin:4px 0 0}
.brand-strip__track{display:flex;height:auto;background:transparent;gap:12px;overflow:auto hidden;scrollbar-width:none;scroll-snap-type:x proximity;scroll-behavior:smooth}
.brand-strip__track::-webkit-scrollbar{display:none}
.brand-strip__item{flex:0 0 auto;width:132px;min-width:0;height:auto;scroll-snap-align:start}
.brand-strip__media{display:block;width:132px;height:132px;min-height:0;padding:0;background:#f6f6f6;overflow:hidden}
.brand-strip__media img{width:100%;height:100%;object-fit:contain;transform:scale(1);transition:transform .35s ease}
.brand-strip__item:hover img,.brand-strip__item:focus-visible img{transform:scale(1.06)}
.brand-strip__label{display:block;height:auto;padding:8px 0 0;background:transparent;font-size:12px;line-height:16px;font-weight:600;letter-spacing:.02em;text-align:center}
.brand-strip__item:active{background:transparent}
@media (max-width:749px){
  .brand-strip{padding:32px 0 40px}
  .brand-strip__track{height:auto}
  .brand-strip__item,.brand-strip__track:not(:hover) .brand-strip__item:first-child{flex:0 0 auto;width:112px}
  .brand-strip__media{width:112px;height:112px}
}
.brand-strip__item{background:transparent;color:inherit}
.brand-strip__media{flex:0 0 132px;height:132px}
.brand-strip__label{color:inherit;opacity:.85}
@media (max-width:749px){.brand-strip__media{flex:0 0 112px;height:112px}}
/* === SEPHORA-GRADE POLISH (end) === */

</style>

{% schema %}
{"name":"Shop by brand","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by brand"},{"type":"text","id":"heading","label":"Heading","default":"Find your favourite brand"}],"blocks":[{"type":"brand","name":"Brand","settings":[{"type":"text","id":"name","label":"Brand name (must match the product vendor exactly)"},{"type":"color","id":"color","label":"Brand colour","default":"#0b2a5b"},{"type":"product","id":"product","label":"Product image"}]}],"presets":[{"name":"Shop by brand"}]}
{% endschema %}
