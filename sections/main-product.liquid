    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    flex-shrink: 0;
  }
  .main-product__sizes { display: inline-flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .main-product__volume--current {
    background: var(--foreground);
    color: var(--background);
    border: 1px solid var(--foreground);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-weight: 600;
  }
  .main-product__volume--link {
    background: var(--background);
    border: 1px solid var(--primary);
    color: var(--primary);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    text-decoration: none;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .main-product__volume--link:hover,
