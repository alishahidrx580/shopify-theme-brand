      <span><strong>Independently lab tested</strong>, skin-friendly pH 5.13. <a href="/pages/lab-test-reports">See the lab results</a> or <a href="https://cdn.shopify.com/s/files/1/0786/6892/3099/files/METS_R_4372-01_Lacleo_Corporate_Services_-_Cosmetics_GSO_1943_1.pdf?v=1782557623" target="_blank" rel="noopener">View the signed report</a>.</span>
    </li>
  </ul>
</div>
<style>
  .cham-pay{margin:14px 0 4px;padding:2px 0}
  .cham-pay__list{list-style:none;margin:0;padding:0;display:grid;gap:8px}
  .cham-pay__item{display:flex;align-items:center;gap:10px;font-size:13px;line-height:1.45;padding:10px 12px;border:1px solid rgba(128,128,128,.28);border-radius:8px}
  .cham-pay__icon{flex:0 0 auto;opacity:.8}
  .cham-pay__item strong{font-weight:600}
  .cham-pay__item--lab{align-items:flex-start}
  .cham-pay__item--lab .cham-pay__icon{margin-top:2px}
  .cham-pay__item a{color:inherit;text-decoration:underline;text-underline-offset:2px;white-space:nowrap}
  .main-product__concern{margin:6px 0 0;font-size:13px;line-height:1.45;letter-spacing:.01em;opacity:.78}
</style>
{%- endif -%}
{%- if product.vendor == 'CHAM' -%}
<div class="cham-trust">
    <p class="cham-trust__eta" data-cham-eta>Estimated delivery time: <strong>3-5 days</strong></p>
  <ul class="cham-trust__row">
    <li class="cham-trust__item"><svg class="cham-trust__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6h13v10H1z"/><path d="M14 9h4l3 3v4h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg><strong>Free shipping</strong><small>on all orders</small></li>
    <li class="cham-trust__item"><svg class="cham-trust__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg><strong>Lab tested</strong><small>skin-friendly pH</small></li>
    <li class="cham-trust__item"><svg class="cham-trust__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 010 12h-3"/></svg><strong>Easy returns</strong><small>3 days</small></li>
  </ul>
</div>
<style>
  .cham-trust{margin:14px 0 6px}
  .cham-trust__eta{margin:0 0 12px;padding:10px 16px;border-radius:999px;font-size:13px;line-height:1.4;background:color-mix(in srgb,currentColor 7%,transparent)}
  .cham-trust__row{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;text-align:center}
  .cham-trust__item{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:12px;line-height:1.3}
  .cham-trust__icon{opacity:.8;margin-bottom:2px}
  .cham-trust__item strong{font-weight:600;font-size:12.5px}
  .cham-trust__item small{font-size:11.5px;opacity:.72}
</style>
<script>
  (function () {
    var el = document.querySelector('[data-cham-eta] strong');
    if (!el) return;
    var months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    function ord(n) { var r = n % 100; if (r > 10 && r < 14) return n + 'th'; var d = n % 10; return n + (d === 1 ? 'st' : d === 2 ? 'nd' : d === 3 ? 'rd' : 'th'); }
    function fmt(dt) { return ord(dt.getDate()) + ' ' + months[dt.getMonth()]; }
        var a = new Date(); a.setDate(a.getDate() + 3);
        var b = new Date(); b.setDate(b.getDate() + 5);
    el.textContent = fmt(a) + ' - ' + fmt(b);
  })();
</script>
{%- endif -%}
{% render 'cham-video-row', product: product %}

        {%- if claims_list != blank and claims_list.size > 0 -%}
