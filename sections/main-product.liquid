    color: var(--destructive);
    font-weight: 600;
  }

  .main-product__urgency--viewers {
    color: var(--muted-foreground);
    font-weight: 500;
    margin-top: 0.75rem;
  }

{% endstylesheet %}

{% javascript %}
  (function () {
    var section = document.currentScript.closest('[data-product-section]');
    if (!section) {
      var all = document.querySelectorAll('[data-product-section]');
      section = all[all.length - 1];
    }
    if (!section) return;

    var form        = section.querySelector('[data-product-form]');
    var stickyBar   = section.querySelector('[data-sticky-bar]');
    var header      = section.querySelector('[data-atc]');
    var description = section.querySelector('[data-description]');
    var seeMore     = section.querySelector('[data-see-more]');
    var track       = section.querySelector('[data-gallery-track]');
    var progress    = section.querySelector('[data-gallery-progress]');

    function addToCart(btn, buyNow) {
      if (!form || btn.disabled) return;
      var fd = new FormData(form);
      btn.setAttribute('data-loading', 'true');
      fetch('/cart/add.js', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (r) {
          if (!r.ok) throw new Error('Add to cart failed');
          return r.json();
        })
        .then(function () {
          if (buyNow) {
            window.location.assign('/checkout');
            return;
          }
          btn.removeAttribute('data-loading');
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          document.dispatchEvent(new CustomEvent('cart:open'));
        })
        .catch(function () {
          btn.removeAttribute('data-loading');
          form.submit();
        });
    }

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var trigger = e.submitter || section.querySelector('[data-atc]');
        addToCart(trigger, trigger.hasAttribute('data-buy-now'));
      });
    }
    var stickyAtc = section.querySelector('[data-atc-sticky]');
    if (stickyAtc) stickyAtc.addEventListener('click', function () { addToCart(stickyAtc); });

    if (description && seeMore) {
      if (window.matchMedia('(max-width: 1023px)').matches) description.classList.add('is-clamped');
      seeMore.addEventListener('click', function () {
        var clamped = description.classList.toggle('is-clamped');
        seeMore.setAttribute('aria-expanded', String(!clamped));
        seeMore.textContent = clamped ? (seeMore.dataset.more || 'See more') : (seeMore.dataset.less || 'See less');
      });
    }

    if (track && progress) {
      var updateProgress = function () {
        var max   = track.scrollWidth - track.clientWidth;
        var ratio = max > 0 ? track.scrollLeft / max : 0;
        var slides = track.children.length || 1;
        progress.style.width     = (100 / slides) + '%';
        progress.style.transform = 'translateX(' + (ratio * (slides - 1) * 100) + '%)';
      };
      track.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
      updateProgress();
    }

    if (stickyBar && header && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          stickyBar.classList.toggle('is-visible', !en.isIntersecting && en.boundingClientRect.top < 0);
        });
      }, { rootMargin: '-80px 0px 0px 0px', threshold: 0 });
      io.observe(header);
    }

})();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "free_shipping_override",
      "label": "t:labels.free_shipping_threshold_override",
      "info": "t:labels.free_shipping_threshold_info",
      "min": 0,
      "max": 9900,
      "step": 100,
      "unit": "Rs",
      "default": 0
    },
    {
      "type": "header",
      "content": "Gallery image fit"
    },
    {
      "type": "select",
      "id": "gallery_fit",
      "label": "Image fit",
      "info": "Fill = crops tiles to the ratio. Show full = whole image visible, may letterbox.",
      "options": [
        { "value": "cover",   "label": "Fill tile (crop)" },
        { "value": "contain", "label": "Show full image (no crop)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "Image ratio",
      "info": "Set to match your photos so nothing gets cropped. Your product images are 3:4.",
      "options": [
        { "value": "3 / 4", "label": "3:4 (portrait — matches your images)" },
        { "value": "4 / 5", "label": "4:5 (portrait)" },
        { "value": "1 / 1", "label": "1:1 (square)" },
        { "value": "4 / 3", "label": "4:3 (landscape)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "select",
      "id": "image_container_width",
      "label": "Image container size",
      "info": "Controls how wide the product image column is on desktop. Use a larger size if you have fewer images.",
      "options": [
        { "value": "1.45", "label": "Normal (default)" },
        { "value": "1.7",  "label": "Large" },
        { "value": "2.0",  "label": "Extra large" },
        { "value": "2.5",  "label": "Maximized" }
      ],
      "default": "1.45"
    },
    {
      "type": "header",
      "content": "Per-image position"
    },
    {
      "type": "paragraph",
      "content": "Each slider pair controls one image by its order in the product's Media. X: 0 = left, 50 = center, 100 = right. Y: 0 = top, 50 = center, 100 = bottom."
    },
    { "type": "range", "id": "image_1_x", "label": "Image 1 - horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "image_1_y", "label": "Image 1 - vertical",   "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "image_2_x", "label": "Image 2 - horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "image_2_y", "label": "Image 2 - vertical",   "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "image_3_x", "label": "Image 3 - horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "image_3_y", "label": "Image 3 - vertical",   "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
