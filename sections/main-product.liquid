{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  assign short_name       = product.metafields.custom.short_name | default: product.title
  assign subtitle         = product.metafields.custom.subtitle
  assign hero_statement   = product.metafields.custom.hero_statement
  assign science_note     = product.metafields.custom.science_note
  assign how_to_use       = product.metafields.custom.how_to_use
  assign full_ingredients = product.metafields.custom.full_ingredients
  assign category_label   = product.metafields.custom.category | default: product.type
  assign claims_list      = product.metafields.custom.claims.value
  assign volume           = product.metafields.custom.volume

  # Ingredients meta — sourced from custom.key_ingredients (list of single-line text).
  # Works whether the value returns as a list OR a single "/", "·" or "," string.
  assign ingredient_raw = product.metafields.custom.key_ingredients.value
  assign ingredient_items = ''
  if ingredient_raw != blank
    assign ing_joined = ingredient_raw | join: '|'
    assign ing_norm = ing_joined | replace: ' / ', '|' | replace: '/', '|' | replace: ' · ', '|' | replace: '·', '|' | replace: ', ', '|' | replace: ',', '|'
    assign ingredient_items = ing_norm | split: '|'
  endif

assign price_formatted = current_variant.price | money
  assign atc_label       = 'Add to bag'
    assign sold_out_label  = 'products.sold_out' | t

      assign compare_at_price = current_variant.compare_at_price
        if compare_at_price > current_variant.price
            assign original_price_formatted = compare_at_price | money
                assign discounted_price_formatted = price_formatted
                  else
                      assign discounted_cents = current_variant.price | times: 0.9 | round
if product.tags contains 'no-discount'
assign discounted_cents = current_variant.price
assign hide_compare_price = true
endif
                          assign original_price_formatted = price_formatted
                              assign discounted_price_formatted = discounted_cents | money
                                endif

                                  if product.has_only_default_variant
                                      assign variant_label = discounted_price_formatted
                                        else
                                            assign variant_label = current_variant.title | append: ' / ' | append: discounted_price_formatted
                                              endif

  assign gallery_fit = section.settings.gallery_fit | default: 'cover'
  assign gallery_ratio = section.settings.gallery_ratio | default: '3 / 4'
  assign image_container_width = section.settings.image_container_width | default: '1.45'
  assign focal_x     = section.settings.gallery_focal_x | default: 50
  assign focal_y     = section.settings.gallery_focal_y | default: 50

  if category_label != blank
    assign breadcrumb_label = category_label
  else
    assign breadcrumb_label = 'sections.main_product.breadcrumb_root' | t
  endif
-%}

<section class="main-product full-width" data-product-section data-product-handle="{{ product.handle }}" style="--gallery-ratio: {{ gallery_ratio }}; --gallery-col-width: {{ image_container_width }}fr;">
  <div class="main-product__inner cham-container">
    <div class="main-product__grid">

      <div class="main-product__gallery" data-gallery>
        <div class="main-product__gallery-track" data-gallery-track>
          {%- if product.images.size > 0 -%}
            {%- for image in product.images -%}
              {%- liquid
                assign mf_x = 'img' | append: forloop.index | append: '_x'
                assign mf_y = 'img' | append: forloop.index | append: '_y'
                assign sx = product.metafields.custom[mf_x].value
                assign sy = product.metafields.custom[mf_y].value
                if sx == blank
                  assign slider_x = 'image_' | append: forloop.index | append: '_x'
                  assign sx = section.settings[slider_x] | default: focal_x
                endif
                if sy == blank
                  assign slider_y = 'image_' | append: forloop.index | append: '_y'
                  assign sy = section.settings[slider_y] | default: focal_y
                endif
                assign img_focal = sx | append: '% ' | append: sy | append: '%'
              -%}
              <figure class="main-product__tile" data-gallery-tile>
                <img
                  src="{{ image | image_url: width: 1200 }}"
                  srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1800 }} 1800w"
                  sizes="(min-width: 1024px) 30vw, 100vw"
                  alt="{{ product.title | escape }}"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="main-product__tile-img"
                  style="object-fit: {{ gallery_fit }}; object-position: {{ img_focal }};"
                  {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                  decoding="async"
                >
              </figure>
            {%- endfor -%}
          {%- else -%}
            <figure class="main-product__tile">
              {{ 'product-1' | placeholder_svg_tag: 'main-product__tile-img' }}
            </figure>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="main-product__gallery-progress" aria-hidden="true">
            <span class="main-product__gallery-progress-fill" data-gallery-progress></span>
          </div>
        {%- endif -%}
      </div>

      <div class="main-product__info">

        <div class="main-product__header">
          <nav class="main-product__breadcrumb" aria-label="Breadcrumb">
            <a href="{{ routes.all_products_collection_url }}" class="main-product__breadcrumb-link eyebrow eyebrow--bare">
              {{ breadcrumb_label }}
            </a>
            <span class="main-product__breadcrumb-sep" aria-hidden="true">&gt;</span>
            <span class="main-product__breadcrumb-current">{{ short_name }}</span>
          </nav>

          <h1 class="main-product__title font-display">{{ product.title }}</h1>

          {%- if subtitle != blank -%}
            <p class="main-product__subtitle">{{ subtitle }}</p>
          {%- endif -%}

          {%- if ingredient_items != blank and ingredient_items.size > 0 -%}
            <p class="main-product__ingredients-meta">
              {%- for ing in ingredient_items -%}
                {%- assign ing_clean = ing | strip -%}
                {%- if ing_clean != blank -%}
                  {{- ing_clean -}}
                  {%- unless forloop.last %} &middot; {% endunless -%}
                {%- endif -%}
              {%- endfor -%}
            </p>
          {%- endif -%}

          {%- if product.metafields.judgeme.badge != blank -%}
            <a href="#reviews" class="main-product__rating">{{ product.metafields.judgeme.badge }}</a>
          {%- endif -%}
        </div>

        {%- if hero_statement != blank -%}
          <p class="main-product__hero-statement font-display">{{ hero_statement }}</p>
        {%- endif -%}

        {%- if product.description != blank -%}
          <div class="main-product__description rte" data-description>{{ product.description }}</div>
          <button type="button" class="main-product__see-more" data-see-more aria-expanded="false" data-more="See more" data-less="See less">
            See more
          </button>
        {%- endif -%}
        <form
          method="post"
          action="{{ routes.cart_add_url }}"
          accept-charset="UTF-8"
          enctype="multipart/form-data"
          class="main-product__form"
          data-product-form
          data-unit-price="{{ current_variant.price }}"
          novalidate
        >
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="&#x2713;">
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          <input type="hidden" name="quantity" value="1">

          <div class="main-product__size-line">
<span class="main-product__price-row">{%- unless hide_compare_price -%}<s class="main-product__price-compare">{{ original_price_formatted }}</s>{%- endunless -%}<span class="main-product__price-sale" data-variant-label>{{ variant_label }}</span></span>
{%- assign other_sizes = product.metafields.custom.other_sizes.value -%}
          {%- if volume != blank or other_sizes != blank -%}
            <span class="main-product__sizes">
              {%- if volume != blank -%}
                <span class="main-product__volume main-product__volume--current">{{ volume }}</span>
              {%- endif -%}
              {%- if other_sizes != blank -%}
                {%- for sibling in other_sizes -%}
                  {%- if sibling != blank and sibling.handle != product.handle -%}
                    <a href="{{ sibling.url }}" class="main-product__volume main-product__volume--link">{{ sibling.metafields.custom.volume }}</a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </span>
          {%- endif -%}
          </div>
{%- if product.vendor == 'CHAM' -%}<p class="main-product__concern">For dullness and uneven tone.</p>{%- endif -%}
{%- if compare_at_price > current_variant.price -%}{%- assign save_cents = compare_at_price | minus: current_variant.price -%}{%- assign save_pct = save_cents | times: 100.0 | divided_by: compare_at_price | round -%}<div class="main-product__save-line" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:10px 0 14px"><span class="main-product__save-pill" style="background:#ce9a43;color:#0d1c42;font-weight:700;font-size:12px;letter-spacing:.06em;padding:4px 10px;border-radius:999px;text-transform:uppercase">{{ save_pct }}% OFF</span><span class="main-product__save-text" style="font-size:13px;font-weight:600;opacity:.85">You save {{ save_cents | money }}</span></div>{%- endif -%}
{%- assign cham_packs = false -%}
{%- if product.vendor == 'CHAM' and product.available -%}{%- if product.handle == 'the-brightening-cream' or product.handle == 'brightening-face-mask' -%}{%- assign cham_packs = true -%}{%- endif -%}{%- endif -%}
{%- if cham_packs -%}
{%- assign pk_1 = current_variant.price -%}
{%- assign pk_2full = current_variant.price | times: 2 -%}
{%- assign pk_2 = current_variant.price | times: 2 | times: 0.95 | round -%}
{%- assign pk_4full = current_variant.price | times: 4 -%}
{%- assign pk_4 = current_variant.price | times: 3 -%}
<div class="cham-packs" role="radiogroup" aria-label="Choose your pack" data-cham-packs>
  <button type="button" class="cham-pack is-active" role="radio" aria-checked="true" data-qty="1">
    <span class="cham-pack__text"><span class="cham-pack__name">1 Pack</span></span>
    <span class="cham-pack__price"><strong>{{ pk_1 | money }}</strong></span>
  </button>
  <button type="button" class="cham-pack" role="radio" aria-checked="false" data-qty="2">
    <span class="cham-pack__text"><span class="cham-pack__name">2 Pack</span><span class="cham-pack__tag">Save 5% more</span></span>
    <span class="cham-pack__price"><s>{{ pk_2full | money }}</s><strong>{{ pk_2 | money }}</strong></span>
  </button>
  {%- if product.handle == 'the-brightening-cream' -%}
  <button type="button" class="cham-pack" role="radio" aria-checked="false" data-qty="4">
    <span class="cham-pack__text"><span class="cham-pack__name">4 Pack</span><span class="cham-pack__tag">Buy 3, get 1 free</span></span>
    <span class="cham-pack__price"><s>{{ pk_4full | money }}</s><strong>{{ pk_4 | money }}</strong></span>
  </button>
  {%- endif -%}
  {%- if product.handle == 'brightening-face-mask' -%}
  {%- assign bonus_p = all_products['the-brightening-cream'] -%}
    <!--dbg {{ bonus_p.title }}|{{ bonus_p.available }}|{{ bonus_p.handle }}|{{ all_products.size }} -->
{%- if bonus_p.available -%}
  {%- assign bonus_v = bonus_p.selected_or_first_available_variant -%}
  {%- assign pk_3full = current_variant.price | times: 3 | plus: bonus_v.price -%}
  {%- assign pk_3 = current_variant.price | times: 3 -%}
  <button type="button" class="cham-pack" role="radio" aria-checked="false" data-qty="3" data-bonus="{{ bonus_v.id }}">
    <span class="cham-pack__text"><span class="cham-pack__name">3 Pack</span><span class="cham-pack__tag">Buy 3, get a free Cream</span></span>
    <span class="cham-pack__price"><s>{{ pk_3full | money }}</s><strong>{{ pk_3 | money }}</strong></span>
  </button>
  {%- endif -%}
  {%- endif -%}
</div>
<style>
  .cham-packs{display:grid;gap:8px;margin:14px 0 6px}
  .cham-pack{all:unset;box-sizing:border-box;cursor:pointer;display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid rgba(128,128,128,.35);border-radius:10px;font-size:14px;line-height:1.3;transition:border-color .15s,background-color .15s}
  .cham-pack::before{content:"";flex:0 0 auto;width:16px;height:16px;border:1.5px solid currentColor;border-radius:50%;opacity:.55;box-sizing:border-box}
  .cham-pack.is-active{border-color:currentColor;background:color-mix(in srgb,currentColor 6%,transparent);box-shadow:0 0 0 1px currentColor inset}
  .cham-pack.is-active::before{opacity:1;background:radial-gradient(circle,currentColor 0 4px,transparent 4.5px)}
  .cham-pack:focus-visible{outline:2px solid currentColor;outline-offset:2px}
  .cham-pack__text{flex:1 1 auto;display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;min-width:0}
  .cham-pack__name{font-weight:600}
  .cham-pack__tag{font-size:11px;line-height:1;padding:4px 8px;border-radius:999px;background:color-mix(in srgb,currentColor 12%,transparent)}
  .cham-pack__price{flex:0 0 auto;display:flex;align-items:baseline;gap:6px;white-space:nowrap}
  .cham-pack__price s{font-size:12px;opacity:.55}
  .cham-pack__price strong{font-weight:600}
</style>
<script>
  document.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('.cham-pack');
    if (!b) return;
    var form = b.closest('form');
    var q = form && form.querySelector('input[name="quantity"]');
    if (!q) return;
    b.parentElement.querySelectorAll('.cham-pack').forEach(function (x) {
      var on = x === b;
      x.classList.toggle('is-active', on);
      x.setAttribute('aria-checked', on ? 'true' : 'false');
    });
    q.value = b.getAttribute('data-qty');
  });
  document.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('.main-product__atc, .main-product__buy-now');
    if (!btn || btn.dataset.chamBonusDone) return;
    var form = btn.closest('form');
    var on = form && form.querySelector('.cham-pack.is-active[data-bonus]');
    if (!on) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    fetch('{{ routes.cart_add_url }}.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [{ id: Number(on.getAttribute('data-bonus')), quantity: 1 }] })
    }).catch(function () {}).then(function () {
      btn.dataset.chamBonusDone = '1';
      btn.click();
      setTimeout(function () { delete btn.dataset.chamBonusDone; }, 1500);
    });
  }, true);
</script>
{%- endif -%}

          <button
            type="submit"
            class="main-product__atc"
            data-atc
            data-atc-label="{{ atc_label | escape }}"
            data-sold-out-label="{{ sold_out_label | escape }}"
            {% if current_variant.available == false %}disabled{% endif %}
          >
            <span data-atc-label>{% if current_variant.available %}{{ atc_label }}{% else %}{{ sold_out_label }}{% endif %}</span>
            <span class="main-product__atc-price" data-atc-price>{{ variant_label }}</span>
          </button>

          <button
            type="submit"
            class="main-product__buy-now"
            data-buy-now
            {% if current_variant.available == false %}disabled{% endif %}
          >
            Buy now
          </button>
        </form>

        {%- if product.vendor == 'CHAM' -%}
<div class="cham-pay" role="note" aria-label="Payment options">
  <ul class="cham-pay__list">
    <li class="cham-pay__item">
      <svg class="cham-pay__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg>
