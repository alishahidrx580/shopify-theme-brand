  .main-product__sticky-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  .main-product__sticky-title {
    font-size: 1.25rem;
    font-weight: 300;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 1023px) {
    .main-product__sticky-title { display: none; }
  }
  .main-product__sticky-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1 1 auto;
    justify-content: flex-end;
  }
  .main-product__atc--sticky {
    margin-top: 0;
    min-height: 3rem;
    flex: 1 1 auto;
