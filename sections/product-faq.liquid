{%- if product.vendor == 'CHAM' -%}
<section class="product-faq product-faq--cham full-width">
  <div class="product-faq__inner cham-container">
    <div class="product-faq__head" data-reveal>
      <span class="eyebrow">Good to know</span>
      <h2 class="product-faq__heading font-display">Shipping &amp; <em>Return.</em></h2>
    </div>
    <div class="product-faq__list" data-reveal data-reveal-delay="100">
      <details class="product-faq__item">
        <summary class="product-faq__question"><span class="product-faq__q-text font-display">Shipping &amp; Return</span><svg class="product-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
        <div class="product-faq__answer"><ul>
          <li>All orders are processed within 24 hours of receipt, excluding weekends and holidays 🚚</li>
          <li>Lahore orders take 1-2 business days to be delivered and other cities take 3-5 business days ✅</li>
          <li>You can track the status of your order at any time by contacting us on our social media platforms 🔍</li>
          <li>Deliveries take up to 5-7 days during sale days 😓</li>
        </ul></div>
      </details>
      <details class="product-faq__item">
        <summary class="product-faq__question"><span class="product-faq__q-text font-display">Order Cancellation Policy</span><svg class="product-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
        <div class="product-faq__answer"><ul>
          <li>If your order has not yet been processed, we will be able to cancel it and issue a full refund 💸</li>
          <li>If your order has already been shipped, we cannot cancel it but you may return the products for a refund in accordance with our return policy 🔙</li>
          <li>Refunds for canceled orders will be processed to the original payment method used for the purchase. Please allow 5-7 business days for the refund to appear on your account 🙏🏼</li>
        </ul></div>
      </details>
    </div>
  </div>
</section>
<section class="product-faq product-faq--cham full-width">
  <div class="product-faq__inner cham-container">
    <div class="product-faq__head" data-reveal>
      <span class="eyebrow">FAQs</span>
      <h2 class="product-faq__heading font-display">Frequently asked <em>questions.</em></h2>
    </div>
    <div class="product-faq__list" data-reveal data-reveal-delay="100">
      <details class="product-faq__item">
        <summary class="product-faq__question"><span class="product-faq__q-text font-display">How long does delivery take?</span><svg class="product-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
        <div class="product-faq__answer"><p>Orders are processed within 24 hours. Lahore orders take 1-2 business days and other cities take 3-5 business days. During sale days, delivery can take up to 5-7 days.</p></div>
      </details>
      <details class="product-faq__item">
        <summary class="product-faq__question"><span class="product-faq__q-text font-display">Is shipping free?</span><svg class="product-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
        <div class="product-faq__answer"><p>Yes, shipping is free on all orders.</p></div>
      </details>
      <details class="product-faq__item">
        <summary class="product-faq__question"><span class="product-faq__q-text font-display">Which payment methods do you accept?</span><svg class="product-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
        <div class="product-faq__answer"><p>You can pay with Cash on Delivery or by bank transfer at checkout. Customers who pay 100% in advance receive a 5% discount.</p></div>
      </details>
      <details class="product-faq__item">
        <summary class="product-faq__question"><span class="product-faq__q-text font-display">Can I return my order?</span><svg class="product-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
        <div class="product-faq__answer"><p>Sealed and unopened items can be returned within 3 days of delivery. Opened items are not eligible for return. See our <a href="/policies/refund-policy">return and refund policy</a> for details.</p></div>
      </details>
      <details class="product-faq__item">
        <summary class="product-faq__question"><span class="product-faq__q-text font-display">What if my order arrives damaged?</span><svg class="product-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
        <div class="product-faq__answer"><p>Message us on WhatsApp with a photo of the product and its packaging as soon as you receive it, and we will replace it.</p></div>
      </details>
      <details class="product-faq__item">
        <summary class="product-faq__question"><span class="product-faq__q-text font-display">Can I cancel my order?</span><svg class="product-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
        <div class="product-faq__answer"><p>Yes, if your order has not been processed yet we can cancel it and issue a full refund. Once an order has shipped it cannot be cancelled, but you may return it in line with our return policy.</p></div>
      </details>
      <details class="product-faq__item">
        <summary class="product-faq__question"><span class="product-faq__q-text font-display">Are there bundle offers on CHAM products?</span><svg class="product-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
        <div class="product-faq__answer"><p>Yes. Buy any 2 CHAM items and save an extra 5%. Buy 3 Brightening Creams and get 1 free, or buy 3 Brightening Face Masks and get a free Brightening Cream. The offers apply automatically in your bag.</p></div>
      </details>
      <details class="product-faq__item">
        <summary class="product-faq__question"><span class="product-faq__q-text font-display">Is CHAM lab tested?</span><svg class="product-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
        <div class="product-faq__answer"><p>The CHAM Brightening Face Cream has been independently lab tested, with a skin-friendly pH of 5.13. <a href="/pages/lab-test-reports">See the lab results</a>.</p></div>
      </details>
      <details class="product-faq__item">
        <summary class="product-faq__question"><span class="product-faq__q-text font-display">How do I track my order?</span><svg class="product-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></summary>
        <div class="product-faq__answer"><p>Contact us on our social media platforms at any time and we will share the status of your order.</p></div>
      </details>
    </div>
  </div>
</section>
{%- endif -%}

{%- liquid
  assign faqs = product.metafields.custom.faqs.value
-%}

{%- if faqs != blank and faqs.size > 0 -%}
  <section class="product-faq full-width">
    <div class="product-faq__inner cham-container">
      <div class="product-faq__head" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="product-faq__heading font-display">
          {{- section.settings.heading_lead -}}
          {%- if section.settings.heading_emphasis != blank %} <em>{{ section.settings.heading_emphasis }}</em>{%- endif -%}
        </h2>
      </div>

      <div class="product-faq__list" data-reveal data-reveal-delay="100">
        {%- for faq in faqs -%}
          <details class="product-faq__item">
            <summary class="product-faq__question">
              <span class="product-faq__q-text font-display">{{ faq.question }}</span>
              <svg class="product-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div class="product-faq__answer">
              {%- render 'rich-text', content: faq.answer.value -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for faq in faqs -%}
          {%- capture rendered_answer -%}{%- render 'rich-text', content: faq.answer.value -%}{%- endcapture -%}
          {
            "@type": "Question",
            "name": {{ faq.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ rendered_answer | strip_html | strip_newlines | strip | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .product-faq {
    width: 100%;
    padding-block: 6rem;
  }

  @media (min-width: 1024px) {
    .product-faq {
      padding-block: 9rem;
    }
  }

  .product-faq__inner {
    max-width: 900px;
    margin-inline: auto;
    padding-inline: var(--page-padding-inline);
  }

  @media (min-width: 1024px) {
    .product-faq__inner {
      padding-inline: var(--page-padding-inline-lg);
    }
  }

  .product-faq__heading {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.05;
  }

  .product-faq__heading em {
    color: var(--primary);
    font-style: italic;
  }

  .product-faq__list {
    margin-top: 3rem;
  }

  @media (min-width: 1024px) {
    .product-faq__list {
      margin-top: 4rem;
    }
  }

  .product-faq__item {
    border-top: 1px solid var(--border);
  }

  .product-faq__item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .product-faq__question {
    list-style: none;
    cursor: pointer;
    padding-block: 1.75rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    color: var(--foreground);
    transition: color 0.3s ease;
  }

  .product-faq__question::-webkit-details-marker {
    display: none;
  }

  .product-faq__question:hover {
    color: var(--primary);
  }

  .product-faq__q-text {
    font-size: 1.25rem;
    line-height: 1.3;
    text-align: left;
  }

  @media (min-width: 1024px) {
    .product-faq__q-text {
      font-size: 1.5rem;
    }
  }

  .product-faq__icon {
    flex-shrink: 0;
    margin-top: 0.25rem;
    color: var(--primary);
    transition: transform 0.3s ease;
  }

  .product-faq__item[open] .product-faq__icon {
    transform: rotate(180deg);
  }

  .product-faq__answer {
    padding-bottom: 1.75rem;
    color: color-mix(in oklab, var(--foreground) 80%, transparent);
    line-height: 1.65;
    font-size: 1rem;
  }

  .product-faq__answer > p {
    margin: 0;
  }

  .product-faq__answer > p + p {
    margin-top: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_faq.name",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.product_faq.info"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading_lead",
      "label": "t:labels.heading_lead",
      "default": "What people"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "t:labels.heading_emphasis",
      "default": "ask."
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_faq.presets_default"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
