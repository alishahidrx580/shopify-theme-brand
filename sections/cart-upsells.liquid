{%- comment -%}
  "You might also like" row for the cart drawer. Never placed on a page: the
  drawer fetches it when it is opened, through Section Rendering, from
    /recommendations/products?section_id=cart-upsells&product_id=…  (Shopify's
      product recommendations for the first item in the cart), or, when that
      returns nothing,
    /collections/<fallback>?section_id=cart-upsells  (Theme settings > Cart
      drawer > Fallback collection), or
    /products/<handle>?section_id=cart-upsells  (a paired product: when the
      cart holds one of the pair set in Theme settings > Cart drawer, the other
      is the only suggestion, e.g. CHAM mask <-> CHAM cream).
  Products already in the cart are removed by assets/cart-drawer.js, because
  this HTML is cached for the visit and the cart changes under it.
  Cards are snippets/cart-upsell-card.liquid.
{%- endcomment -%}
{%- liquid
  assign up_products = blank
  assign up_single = blank
  if recommendations.performed and recommendations.products_count > 0
    assign up_products = recommendations.products
  elsif collection
    assign up_products = collection.products
  elsif product
    assign up_single = product
  endif
-%}
<div class="cart-upsells" data-cart-upsells-content>
  {%- if up_products != blank or up_single != blank -%}
    <div class="cart-upsells__head">
      <h4 class="cart-upsells__title" id="cart-upsells-title">{{ settings.cart_upsell_heading | escape }}</h4>
      <div class="cart-upsells__arrows">
        <button type="button" class="cart-upsells__arrow" data-upsell-scroll="-1" aria-label="Previous products" aria-controls="cart-upsells-track">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="cart-upsells__arrow" data-upsell-scroll="1" aria-label="Next products" aria-controls="cart-upsells-track">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>
    <ul class="cart-upsells__track" id="cart-upsells-track" role="list" aria-labelledby="cart-upsells-title">
      {%- if up_single != blank -%}
        {%- if up_single.available -%}{%- render 'cart-upsell-card', product: up_single -%}{%- endif -%}
      {%- else -%}
        {%- for up_product in up_products limit: 12 -%}
          {%- if up_product.available -%}{%- render 'cart-upsell-card', product: up_product -%}{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  {%- endif -%}
</div>


{% stylesheet %}
  .cart-upsells__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2rem 0.75rem;
  }

  .cart-upsells__title {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--foreground);
  }

  .cart-upsells__arrows {
    display: flex;
    gap: 0.25rem;
  }

  .cart-upsells__arrows[hidden] {
    display: none;
  }

  .cart-upsells__arrow {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    color: var(--foreground);
  }

  .cart-upsells__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .cart-upsells__track {
    list-style: none;
    margin: 0;
    padding: 0 2rem;
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 2rem;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .cart-upsells__track::-webkit-scrollbar {
    display: none;
  }

  .cart-upsell {
    flex: 0 0 15rem;
    max-width: 80%;
    display: flex;
    gap: 0.75rem;
    padding: 0.625rem;
    border: 1px solid var(--border);
    scroll-snap-align: start;
  }

  .cart-upsell__image {
    flex-shrink: 0;
    width: 4.5rem;
    aspect-ratio: 4 / 5;
    background-color: var(--surface);
    overflow: hidden;
  }

  .cart-upsell__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-upsell__body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cart-upsell__title {
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--foreground);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-upsell__price {
    margin: 0;
    font-size: 0.8125rem;
    display: flex;
    gap: 0.375rem;
    align-items: baseline;
  }

  .cart-upsell__compare {
    font-size: 0.6875rem;
    color: var(--muted-foreground);
  }

  .cart-upsell__add {
    margin-top: auto;
    align-self: flex-start;
    min-height: 2rem;
    padding: 0.375rem 1rem;
    border: 1px solid var(--foreground);
    color: var(--foreground);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .cart-upsell__add:hover,
  .cart-upsell__add:focus-visible {
    background-color: var(--foreground);
    color: var(--background);
  }

  .cart-upsell__add[data-loading] {
    opacity: 0.5;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-upsells__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart upsells",
  "settings": []
}
{% endschema %}
