{% doc %}
  Bag reminder bar (phones and tablets). A shopper who adds a product, closes
  the cart drawer and keeps reading had nothing on screen saying the bag still
  holds something; on desktop the header cart count does that job.

  Shown only while the cart has items and the drawer is closed. Count and total
  are kept current by assets/cart-drawer.js after every cart change. The close
  button hides it for the visit, until the cart changes again.
  Switch: Theme settings > Cart drawer > Bag reminder.

  @example
  {% render 'bag-reminder' %}
{% enddoc %}

{%- if settings.cart_reminder_enable and template.name != 'cart' -%}
  <div class="bag-reminder" data-bag-reminder role="region" aria-label="Your bag" hidden>
    <button type="button" class="bag-reminder__open" data-cart-trigger>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <span data-bag-reminder-text>
        {{- cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %} in your bag · {{ cart.total_price | money -}}
      </span>
    </button>
    <a href="/checkout" class="bag-reminder__checkout">Checkout</a>
    <button type="button" class="bag-reminder__close" data-bag-reminder-close aria-label="Hide bag reminder">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
{%- endif -%}

{% stylesheet %}
  .bag-reminder {
    position: fixed;
    left: 0;
    right: 0;
    /* Sits on top of the product page's sticky Add to bag bar when that bar
       is showing (sections/main-product.liquid sets --sticky-atc-h). */
    bottom: var(--sticky-atc-h, 0px);
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding: 0.375rem 0.25rem 0.375rem 1rem;
    background-color: var(--brand-navy, #061832);
    color: #fff;
  }

  .bag-reminder[hidden],
  html[data-drawer-open="true"] .bag-reminder {
    display: none;
  }

  .bag-reminder__open {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    font-size: 0.8125rem;
    line-height: 1.3;
    text-align: left;
  }

  .bag-reminder__open svg {
    flex-shrink: 0;
  }

  .bag-reminder__checkout {
    flex-shrink: 0;
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
    padding: 0 1rem;
    background-color: var(--cta-bg, #ce9a43);
    color: var(--cta-fg, #061832);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bag-reminder__close {
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    color: inherit;
    opacity: 0.8;
  }

  /* The WhatsApp button moves up so the bar does not cover it. */
  html[data-bag-bar] .whatsapp-float {
    bottom: calc(1.25rem + 3.25rem + var(--sticky-atc-h, 0px));
  }

  /* Desktop keeps the header cart count in view, so no bar there. */
  @media (min-width: 1024px) {
    .bag-reminder {
      display: none;
    }

    html[data-bag-bar] .whatsapp-float {
      bottom: 2rem;
    }
  }
{% endstylesheet %}
