{% doc %}
  Renders Product and BreadcrumbList JSON-LD for a product page.

  Replaces Shopify's `{{ product | structured_data }}` filter, which on this
  store emitted the compare-at price instead of the selling price. Prices
  here come from each variant's own `price` field, so the schema always
  matches what the customer is charged.

  Emits one Offer per variant, plus `sku` and `gtin` when the variant has
  them. Deliberately omits `aggregateRating` and `review`: the store has no
  real customer reviews, and rating markup without real reviews is a
  structured-data violation. Add them only once genuine reviews exist.

  Also omits `shippingDetails` and `hasMerchantReturnPolicy`, because
  delivery windows and return windows differ per sourcing tier on this store
  and must be taken from the policy pages rather than guessed.

  @param {product} product - The product to describe
  @param {collection} [collection] - Collection the visitor arrived through, used for the breadcrumb trail

  @example
  {% render 'schema-product', product: product %}
  {% render 'schema-product', product: product, collection: collection %}
{% enddoc %}

{%- liquid
  assign currency_code = cart.currency.iso_code | default: shop.currency

  assign description = product.description | strip_html | strip_newlines | strip | truncate: 500

  # Google requires the price the customer is actually charged. This store
  # discounts two different ways and the schema has to follow both:
  #
  #   CHAM products carry a real compare_at_price, so variant.price already IS
  #   the charged price (for example Rs 3,284 struck through, Rs 2,299 charged).
  #   Nothing to adjust.
  #
  #   Every other product has no compare_at_price and is covered by a Shopify
  #   automatic discount. Automatic discounts are invisible to Liquid, so
  #   variant.price is the PRE-discount figure. Left alone, the schema
  #   advertises a price nobody pays.
  #
  # So mirror the same rule the storefront display uses. The percentage comes
  # from settings so display and schema cannot drift apart, but it still has to
  # be kept equal to the Shopify discount by hand.
  assign discount_percent = settings.automatic_discount_percent | default: 0
  assign apply_auto_discount = false
  if discount_percent > 0
    assign apply_auto_discount = true
    if product.tags contains 'no-discount'
      assign apply_auto_discount = false
    endif
  endif
  assign discount_factor = 100 | minus: discount_percent | divided_by: 100.0

  assign breadcrumb_collection = collection
  if breadcrumb_collection == blank
    assign breadcrumb_collection = product.collections.first
  endif
-%}

{%- if product != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ shop.url | append: product.url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ shop.url | append: product.url | json }}
      {%- if description != blank -%}
        ,"description": {{ description | json }}
      {%- endif -%}
      {%- if product.vendor != blank -%}
        ,"brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        }
      {%- endif -%}
      {%- if product.type != blank -%}
        ,"category": {{ product.type | json }}
      {%- endif -%}
      {%- if product.images.size > 0 -%}
        ,"image": [
          {%- for image in product.images limit: 5 -%}
            {{ image | image_url: width: 1200 | prepend: 'https:' | json }}
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      {%- endif -%}
      {%- if product.variants.size > 0 -%}
        ,"offers": [
          {%- for variant in product.variants -%}
            {%- liquid
              assign offer_cents = variant.price

              # compare_at_price is nil on most products here, and Liquid will
              # not compare nil with a number, so the sale test has to check
              # for blank first. Getting this wrong silently skips the
              # discount and publishes the pre-discount price.
              assign variant_on_sale = false
              if variant.compare_at_price != blank and variant.compare_at_price > variant.price
                assign variant_on_sale = true
              endif

              if apply_auto_discount and variant_on_sale == false
                assign offer_cents = variant.price | times: discount_factor | round
              endif
            -%}
            {
              "@type": "Offer",
              "url": {{ shop.url | append: variant.url | json }},
              "price": {{ offer_cents | divided_by: 100.0 }},
              "priceCurrency": {{ currency_code | json }},
              "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
              "itemCondition": "https://schema.org/NewCondition"
              {%- if variant.sku != blank -%}
                ,"sku": {{ variant.sku | json }}
              {%- endif -%}
              {%- if variant.barcode != blank -%}
                ,"gtin": {{ variant.barcode | json }}
              {%- endif -%}
              {%- if variant.title != blank and variant.title != 'Default Title' -%}
                ,"name": {{ variant.title | json }}
              {%- endif -%}
              ,"seller": { "@id": {{ shop.url | append: '/#organization' | json }} }
            }
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      {%- endif -%}
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        }
        {%- if breadcrumb_collection != blank -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ breadcrumb_collection.title | json }},
            "item": {{ shop.url | append: breadcrumb_collection.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
