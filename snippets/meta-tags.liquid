<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'

  # Meta description fallback chain. Shopify only fills `page_description`
  # when a merchant has typed one in admin, so without a fallback most pages
  # ship with no description at all and Google writes its own snippet.
  assign meta_description = page_description
  if meta_description == blank
    case request.page_type
      when 'index'
        assign meta_description = settings.seo_home_description | default: shop.description
      when 'product'
        assign meta_description = product.description
      when 'collection'
        assign meta_description = collection.description
      when 'article'
        assign meta_description = article.excerpt_or_content
      when 'blog'
        assign meta_description = blog.metafields.custom.description
      when 'page'
        assign meta_description = page.content
    endcase
  endif
  assign meta_description = meta_description | strip_html | strip_newlines | strip | truncate: 155
  if meta_description == blank
    assign meta_description = shop.description
  endif

  assign og_description = meta_description | default: shop.name

  # The homepage title is just the shop name unless a merchant sets an SEO
  # title in admin, which leaves it far too short to rank for anything. The
  # theme setting lets us carry the category and market without admin access.
  assign seo_title = page_title
  if request.page_type == 'index' and settings.seo_home_title_suffix != blank
    assign seo_title = shop.name | append: ' | ' | append: settings.seo_home_title_suffix
    assign og_title = seo_title
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- comment -%}
  Share image: prefer the page's own image, then the theme's social fallback,
  then the brand logo. Without a fallback the homepage and every page with no
  image of its own shares with no preview image at all.
{%- endcomment -%}
{%- liquid
  assign share_image = page_image
  if share_image == blank
    assign share_image = settings.social_share_image
  endif
  if share_image == blank
    assign share_image = settings.brand_logo
  endif
-%}

{%- if share_image != blank -%}
  <meta
    property="og:image"
    content="https:{{ share_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ share_image | image_url: width: 1200 }}"
  >
  {%- if share_image.width and share_image.height -%}
    <meta
      property="og:image:width"
      content="{{ share_image.width }}"
    >
    <meta
      property="og:image:height"
      content="{{ share_image.height }}"
    >
  {%- endif -%}
  <meta
    name="twitter:image"
    content="https:{{ share_image | image_url: width: 1200 }}"
  >
{%- endif -%}

{%- comment -%}
  Structured data. Product schema is rendered by our own snippet rather than
  the `structured_data` filter, which emitted the compare-at price instead of
  the selling price.
{%- endcomment -%}
{%- case request.page_type -%}
  {%- when 'index' -%}
    {% render 'schema-organization' %}
  {%- when 'product' -%}
    {% render 'schema-product', product: product, collection: collection %}
  {%- when 'collection' -%}
    {% render 'schema-collection', collection: collection %}
{%- endcase -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{- seo_title -}}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- if meta_description != blank -%}
  <meta
    name="description"
    content="{{ meta_description | escape }}"
  >
{%- endif -%}
