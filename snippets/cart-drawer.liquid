{% doc %}
  Renders the global side-drawer cart. Hydrates server-side from the `cart`
  object; client-side mutations (qty change, remove) go through Shopify's
  Ajax Cart API in assets/cart-drawer.js.

  Triggered by any element with `data-cart-trigger` (typically the header
  cart icon button). Closed by `data-cart-close`, the Esc key, or clicking
  the overlay.

  @example
  {% render 'cart-drawer' %}
{% enddoc %}

<div class="cart-drawer" data-cart-drawer aria-hidden="true" inert>
  <div class="cart-drawer__overlay" data-cart-close></div>

  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title">
    <span data-cart-count-sync="{{ cart.item_count }}" hidden></span>
    <header class="cart-drawer__header">
      <h3 class="eyebrow" id="cart-drawer-title">
        {{ 'sections.cart_drawer.title' | t }}
        <span class="cart-drawer__count" data-cart-count-text>
          {%- if cart.item_count > 0 -%}({{ cart.item_count }}){%- endif -%}
        </span>
      </h3>
      <button type="button" class="cart-drawer__close" data-cart-close data-focus-id="close" aria-label="{{ 'general.accessibility.close_cart' | t }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </header>

    {%- if cart.item_count == 0 -%}
      <div class="cart-drawer__empty">
        <p class="cart-drawer__empty-heading font-display">
          {{ 'sections.cart_drawer.empty_heading_lead' | t }}
          <em>{{ 'sections.cart_drawer.empty_heading_emphasis' | t }}</em>
        </p>
        <p class="cart-drawer__empty-body">
          {{ 'sections.cart_drawer.empty_paragraph' | t }}
        </p>
        <a href="{{ routes.all_products_collection_url }}" class="cart-drawer__empty-cta" data-cart-close>
          {{ 'sections.cart_drawer.empty_cta' | t }}
        </a>
      </div>
    {%- else -%}
      {%- comment -%}
        CHAM offer progress. Mirrors the three automatic discounts live in
        Shopify (checked 2026-11-16) and the free-cream rule in
        layout/theme.liquid (one free cream per full set of 3 masks):
          "CHAM: buy 2, save 35% in total"      any 2+ CHAM items
          "CHAM: buy 3 masks, get a free cream" 3, 6, ... masks
          "CHAM: buy 3 creams, get 1 free"      4 creams
        If any of those discounts changes or ends in Shopify admin, change
        this block or switch it off in Theme settings > Cart drawer.
      {%- endcomment -%}
      {%- assign cham_shown = false -%}
      {%- if settings.cart_cham_progress_enable -%}
        {%- liquid
          assign cham_mask = all_products['brightening-face-mask']
          assign cham_cream = all_products['the-brightening-cream']
          assign cham_m = 0
          assign cham_c = 0
          assign cham_free_c = 0
          for item in cart.items
            if item.product_id == cham_mask.id
              assign cham_m = cham_m | plus: item.quantity
            elsif item.product_id == cham_cream.id
              assign cham_c = cham_c | plus: item.quantity
              if item.final_line_price == 0
                assign cham_free_c = cham_free_c | plus: item.quantity
              endif
            endif
          endfor
          assign cham_n = cham_m | plus: cham_c
          assign cham_msg = ''
          assign cham_done = false
          assign cham_ratio = 0
          if cham_n > 0
            assign cham_shown = true
            if cham_m > 0
              assign cham_rem = cham_m | modulo: 3
              assign cham_need = 3 | minus: cham_rem
              assign cham_next_free = cham_m | plus: cham_need | divided_by: 3
              assign cham_ratio = cham_rem | times: 1.0 | divided_by: 3
              assign cham_s = 's'
              if cham_need == 1
                assign cham_s = ''
              endif
              assign cham_cs = 's'
              if cham_next_free == 1
                assign cham_cs = ''
              endif
              if cham_rem == 0 and cham_free_c > 0
                assign cham_done = true
                assign cham_ratio = 1
                if cham_free_c == 1
                  assign cham_msg = 'Free Brightening Cream unlocked'
                else
                  assign cham_msg = cham_free_c | append: ' free Brightening Creams unlocked'
                endif
              elsif cham_n == 1
                assign cham_msg = 'Add 1 more CHAM product to <strong>save 35% in total</strong>'
              elsif cham_rem == 0
                assign cham_msg = 'Save 35% in total unlocked'
                assign cham_done = true
                assign cham_ratio = 1
              else
                assign cham_msg = 'Add ' | append: cham_need | append: ' more mask' | append: cham_s | append: ' to get <strong>' | append: cham_next_free | append: ' free Brightening Cream' | append: cham_cs | append: '</strong>'
              endif
            else
              assign cham_rem = cham_c | modulo: 4
              assign cham_ratio = cham_rem | times: 1.0 | divided_by: 4
              if cham_rem == 0
                assign cham_done = true
                assign cham_ratio = 1
                assign cham_msg = 'Buy 3 + 1 Free unlocked'
              elsif cham_c == 1
                assign cham_msg = 'Add 1 more CHAM product to <strong>save 35% in total</strong>'
              else
                assign cham_need = 4 | minus: cham_rem
                assign cham_s = 's'
                if cham_need == 1
                  assign cham_s = ''
                endif
                assign cham_msg = 'Add ' | append: cham_need | append: ' more cream' | append: cham_s | append: ' to get <strong>Buy 3 + 1 Free</strong>'
              endif
            endif
          endif
          assign cham_pct = cham_ratio | times: 100 | floor
        -%}
        {%- if cham_shown -%}
          <div class="cart-progress{% if cham_done %} cart-progress--done{% endif %}">
            <p class="cart-progress__message">{{ cham_msg }}</p>
            <div
              class="cart-progress__track"
              role="progressbar"
              aria-label="Progress towards the CHAM offer"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="{{ cham_pct }}"
            >
              <span class="cart-progress__fill" style="--progress: {{ cham_ratio }}"></span>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%}
        Reward progress. Off by default: it must only be switched on when a
        matching reward actually exists in Shopify (see Theme settings > Cart
        drawer). Measured against the items subtotal, which is what an
        automatic discount's minimum purchase is checked against.
      {%- endcomment -%}
      {%- assign progress_goal = settings.cart_progress_threshold | default: 0 | times: 100 -%}
      {%- if settings.cart_progress_enable and progress_goal > 0 and cham_shown == false -%}
        {%- liquid
          assign progress_spent = cart.items_subtotal_price
          assign progress_left = progress_goal | minus: progress_spent
          assign progress_ratio = progress_spent | times: 1.0 | divided_by: progress_goal
          if progress_ratio > 1
            assign progress_ratio = 1
          endif
          assign progress_pct = progress_ratio | times: 100 | floor
          assign progress_amount = progress_left | money | prepend: '<strong>' | append: '</strong>'
        -%}
        <div class="cart-progress{% if progress_left <= 0 %} cart-progress--done{% endif %}">
          <p class="cart-progress__message">
            {%- if progress_left > 0 -%}
              {{ settings.cart_progress_message | escape | replace: '[amount]', progress_amount }}
            {%- else -%}
              {{ settings.cart_progress_success | escape }}
            {%- endif -%}
          </p>
          <div
            class="cart-progress__track"
            role="progressbar"
            aria-label="Progress towards reward"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="{{ progress_pct }}"
          >
            <span class="cart-progress__fill" style="--progress: {{ progress_ratio }}"></span>
          </div>
        </div>
      {%- endif -%}

      <div class="cart-drawer__body">
      <ul class="cart-drawer__items">
        {%- for item in cart.items -%}
          {%- assign volume = item.product.metafields.custom.volume -%}
          {%- unless item.product.has_only_default_variant -%}
            {%- assign volume = item.variant.title -%}
          {%- endunless -%}
          {%- comment -%}
            Reference price for the strike-through and "You save": the real
            compare-at price, or the pre-discount price when an automatic
            discount lowers the line. Same rule as the Total savings row below.
          {%- endcomment -%}
          {%- liquid
            assign line_ref = item.variant.compare_at_price | default: 0
            if line_ref < item.original_price
              assign line_ref = item.original_price
            endif
            assign line_saved = line_ref | minus: item.final_price | times: item.quantity
          -%}
          <li class="cart-drawer__item" data-line-key="{{ item.key }}" data-product-id="{{ item.product_id }}">
            <a href="{{ item.url }}" class="cart-drawer__item-image" data-cart-close tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                <img
                  src="{{ item.image | image_url: width: 160 }}"
                  srcset="{{ item.image | image_url: width: 80 }} 80w, {{ item.image | image_url: width: 160 }} 160w, {{ item.image | image_url: width: 240 }} 240w"
                  sizes="80px"
                  alt=""
                  loading="lazy"
                  width="80"
                  height="96"
                >
              {%- endif -%}
            </a>
            <div class="cart-drawer__item-body">
              <div class="cart-drawer__item-header">
                <a href="{{ item.url }}" class="cart-drawer__item-title font-display" data-cart-close>
                  {{ item.product.title }}
                </a>
                <span class="cart-drawer__item-line-price">{{ item.final_line_price | money }}</span>
              </div>
              {%- if volume != blank -%}
                <p class="cart-drawer__item-volume">{{ volume }}</p>
              {%- endif -%}
              {%- if settings.cart_show_line_details -%}
                {%- liquid
                  assign shown_props = 0
                  for prop in item.properties
                    assign prop_first = prop.first | slice: 0
                    if prop.last != blank and prop_first != '_'
                      assign shown_props = shown_props | plus: 1
                    endif
                  endfor
                -%}
                {%- if shown_props > 0 -%}
                  <ul class="cart-drawer__item-details">
                    {%- for prop in item.properties -%}
                      {%- assign prop_first = prop.first | slice: 0 -%}
                      {%- if prop.last != blank and prop_first != '_' -%}
                        <li>{{ prop.first }}: {{ prop.last }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
                {%- if item.item_components.size > 0 -%}
                  <ul class="cart-drawer__item-details cart-drawer__item-details--bundle" aria-label="Bundle contents">
                    {%- for component in item.item_components -%}
                      <li>{{ component.quantity }} &times; {{ component.title }}</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              {%- endif -%}
              <p class="cart-drawer__item-unit-pricing">
                <span class="cart-drawer__item-unit-price">{{ item.final_price | money }}</span>
                {%- if line_ref > item.final_price -%}
                  <s class="cart-drawer__item-compare"><span class="visually-hidden">Regular price </span>{{ line_ref | money }}</s>
                {%- endif -%}
              </p>
              {%- if settings.cart_show_savings and line_saved > 0 -%}
                <p class="cart-drawer__item-saved">You save {{ line_saved | money }}</p>
              {%- endif -%}
              <div class="cart-drawer__item-controls">
                <div class="cart-drawer__qty">
                  <button
                    type="button"
                    class="cart-drawer__qty-btn"
                    data-cart-qty
                    data-line="{{ forloop.index }}"
                    data-delta="-1"
                    data-focus-id="dec-{{ item.variant_id }}"
                    aria-label="{{ 'general.accessibility.decrease_quantity' | t }}: {{ item.product.title | escape }}"
                  >
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                  </button>
                  <span class="cart-drawer__qty-value" aria-label="Quantity">{{ item.quantity }}</span>
                  <button
                    type="button"
                    class="cart-drawer__qty-btn"
                    data-cart-qty
                    data-line="{{ forloop.index }}"
                    data-delta="1"
                    data-focus-id="inc-{{ item.variant_id }}"
                    aria-label="{{ 'general.accessibility.increase_quantity' | t }}: {{ item.product.title | escape }}"
                  >
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                      <line x1="12" y1="5" x2="12" y2="19"/>
                      <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                  </button>
                </div>
                <button
                  type="button"
                  class="cart-drawer__item-remove"
                  data-cart-remove
                  data-line="{{ forloop.index }}"
                  aria-label="{{ 'general.accessibility.remove_item' | t }}: {{ item.product.title | escape }}"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="3 6 5 6 21 6"/>
                    <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/>
                    <path d="M10 11v6M14 11v6"/>
                    <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
                  </svg>
                </button>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- comment -%}
        Paired products (CHAM mask <-> CHAM cream by default): if the cart holds
        one of the pair, the other is the only suggestion; with both, none.
      {%- endcomment -%}
      {%- liquid
        assign up_pair = ''
        assign up_show = settings.cart_upsell_enable
        if settings.cart_pair_enable
          assign pair_a = settings.cart_pair_a | default: all_products['brightening-face-mask']
          assign pair_b = settings.cart_pair_b | default: all_products['the-brightening-cream']
          assign has_a = false
          assign has_b = false
          for item in cart.items
            if pair_a and item.product_id == pair_a.id
              assign has_a = true
            endif
            if pair_b and item.product_id == pair_b.id
              assign has_b = true
            endif
          endfor
          if has_a and has_b
            assign up_show = false
          elsif has_a and pair_b
            assign up_pair = pair_b.handle
          elsif has_b and pair_a
            assign up_pair = pair_a.handle
          endif
        endif
      -%}
      {%- if up_show -%}
        {%- comment -%}
          Filled by assets/cart-drawer.js when the drawer opens; nothing is
          requested before that. The reserved height keeps the row from
          pushing anything when it arrives.
        {%- endcomment -%}
        <div
          class="cart-upsells-slot"
          data-cart-upsells
          data-pair="{{ up_pair }}"
          data-product-id="{{ cart.items.first.product_id }}"
          data-fallback="{{ settings.cart_upsell_collection.handle }}"
          data-limit="{{ settings.cart_upsell_limit | default: 8 }}"
        ></div>
      {%- endif -%}
      </div>

      <footer class="cart-drawer__footer">
        {%- assign gift_message = cart.attributes['Gift Message'] -%}
        {%- assign gift_message_max = settings.gift_message_max | default: 240 -%}

        {%- if gift_message != blank -%}
          <details class="cart-drawer__gift-options" data-cart-gift-options open>
            <summary class="cart-drawer__gift-summary">
              <span class="cart-drawer__gift-summary-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 12 20 22 4 22 4 12"/>
                  <rect x="2" y="7" width="20" height="5"/>
                  <line x1="12" y1="22" x2="12" y2="7"/>
                  <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
                  <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
                </svg>
                <span>{{ 'sections.cart_drawer.gift_message_label' | t }}</span>
              </span>
              <span class="cart-drawer__gift-toggle" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <line class="cart-drawer__gift-toggle-vertical" x1="12" y1="5" x2="12" y2="19"/>
                </svg>
              </span>
            </summary>

            <div class="cart-drawer__gift-message-field">
              <textarea
                id="CartDrawerGiftMessage"
                data-cart-gift-message
                maxlength="{{ gift_message_max }}"
                placeholder="{{ 'sections.cart_drawer.gift_message_placeholder' | t }}"
                rows="2"
              >{{ gift_message }}</textarea>
              <p class="cart-drawer__gift-message-meta">
                <span class="cart-drawer__gift-message-status" data-cart-gift-message-status hidden>
                  {{ 'sections.cart_drawer.gift_message_saved' | t }}
                </span>
                <span class="cart-drawer__gift-message-count">
                  <span data-cart-gift-message-count>{{ gift_message.size }}</span>/{{ gift_message_max }}
                </span>
              </p>
            </div>
          </details>
        {%- endif -%}

        <details class="cart-drawer__discount"{% if cart.cart_level_discount_applications.size > 0 %} open{% endif %}>
          <summary class="cart-drawer__discount-summary">
            <span class="cart-drawer__discount-label">{{ 'sections.cart_drawer.discount_label' | t }}</span>
            <span class="cart-drawer__discount-toggle" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <line class="cart-drawer__discount-toggle-vertical" x1="12" y1="5" x2="12" y2="19"/>
              </svg>
            </span>
          </summary>
          <form class="cart-drawer__discount-form" data-discount-form>
            <input
              type="text"
              name="discount"
              class="cart-drawer__discount-input"
              placeholder="{{ 'sections.cart_drawer.discount_placeholder' | t }}"
              aria-label="{{ 'sections.cart_drawer.discount_label' | t }}"
              autocomplete="off"
              spellcheck="false"
              data-discount-input
            >
            <button type="submit" class="cart-drawer__discount-btn">
              {{ 'sections.cart_drawer.discount_apply' | t }}
            </button>
          </form>

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="cart-drawer__applied-discounts">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li>{{ discount.title }} · −{{ discount.total_allocated_amount | money }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <p class="cart-drawer__discount-error" data-discount-error hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span>{{ 'sections.cart_drawer.discount_invalid' | t }}</span>
          </p>
        </details>

        <div class="cart-drawer__totals">
      {%- liquid
        assign cham_full = 0
        for item in cart.items
          assign cham_cp = item.variant.compare_at_price | default: 0
          if cham_cp < item.original_price
            assign cham_cp = item.original_price
          endif
          assign cham_line = cham_cp | times: item.quantity
          assign cham_full = cham_full | plus: cham_line
        endfor
        assign cham_saved = cham_full | minus: cart.total_price
      -%}
      {%- if settings.cart_show_savings and cham_saved > 0 -%}
        <div class="cart-drawer__row cart-drawer__row--saved" style="color:var(--primary);font-weight:600">
          <span>Total savings</span>
          <span>&minus; {{ cham_saved | money }}</span>
        </div>
      {%- endif -%}
          <div class="cart-drawer__row cart-drawer__row--total">
            <span>{{ 'sections.cart_drawer.total' | t }}</span>
            <span class="font-display cart-drawer__total-amount">{{ cart.total_price | money }}</span>
          </div>
        </div>

        {%- comment -%}
          Same-day dispatch timer, CHAM only (pharmacy brands are sourced to
          order, so "ships today" would not be true for them). The cutoff and
          days come from the owner (Theme settings > Cart drawer); the text is
          filled in by assets/cart-drawer.js in Pakistan time and stays hidden
          without JS.
        {%- endcomment -%}
        {%- if settings.cart_dispatch_enable -%}
          {%- assign dispatch_cham = false -%}
          {%- for item in cart.items -%}
            {%- if item.vendor == 'CHAM' -%}{%- assign dispatch_cham = true -%}{%- endif -%}
          {%- endfor -%}
          {%- if dispatch_cham -%}
            <p
              class="cart-drawer__dispatch"
              data-cart-dispatch
              data-cutoff="{{ settings.cart_dispatch_cutoff | default: 18 }}"
              data-days="{{ settings.cart_dispatch_days | default: '1,2,3,4,5,6' }}"
              hidden
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="1" y="3" width="15" height="13"/>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                <circle cx="5.5" cy="18.5" r="2.5"/>
                <circle cx="18.5" cy="18.5" r="2.5"/>
              </svg>
              <span data-cart-dispatch-text></span>
            </p>
          {%- endif -%}
        {%- endif -%}
        <a href="/checkout" class="cart-drawer__checkout">
          {{ 'sections.cart_drawer.checkout' | t }}
        </a>
        {%- if settings.cart_trust_enable and settings.cart_trust_text != blank -%}
          <p class="cart-drawer__trust">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
            <span>{{ settings.cart_trust_text | escape }}</span>
          </p>
        {%- endif -%}
        <a href="{{ routes.all_products_collection_url }}" class="cart-drawer__continue" data-cart-close>
          {{ 'sections.cart_drawer.continue_shopping' | t }}
        </a>
      </footer>
    {%- endif -%}
  </aside>
  <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-cart-live></p>
</div>

{% stylesheet %}
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 70;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .cart-drawer[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  .cart-drawer__overlay {
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 0.7);
  }

  .cart-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: 100%;
    max-width: 440px;
    background-color: var(--background);
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.5s ease;
  }

  .cart-drawer[aria-hidden="false"] .cart-drawer__panel {
    transform: translateX(0);
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2rem;
    height: 5rem;
    border-bottom: 1px solid var(--border);
  }

  .cart-drawer__count {
    color: var(--primary);
    text-transform: none;
    letter-spacing: normal;
    margin-left: 0.25rem;
  }

  .cart-drawer__close {
    color: var(--foreground);
    display: inline-flex;
  }

  .cart-drawer__empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
  }

  .cart-drawer__empty-heading {
    font-size: 1.875rem;
    line-height: 1.15;
    color: color-mix(in oklab, var(--foreground) 90%, transparent);
  }

  .cart-drawer__empty-heading em {
    color: var(--primary);
    font-style: italic;
  }

  .cart-drawer__empty-body {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
    max-width: 18rem;
    line-height: 1.5;
  }

  .cart-drawer__empty-cta {
    display: inline-block;
    margin-top: 2rem;
    padding: 1rem 2rem;
    border: 1px solid var(--primary);
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.75rem;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .cart-drawer__empty-cta:hover {
    background-color: var(--primary);
    color: var(--primary-foreground);
  }

  .cart-drawer__body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .cart-drawer__items {
    padding: 0;
    margin: 0;
  }

  .cart-drawer__item {
    display: flex;
    gap: 1rem;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--border);
    transition: opacity 0.2s ease;
  }

  .cart-drawer__item[data-loading="true"] {
    opacity: 0.5;
  }

  .cart-drawer__item[data-loading="true"] button {
    pointer-events: none;
  }

  .cart-drawer__item-image {
    display: block;
    width: 5rem;
    height: 6rem;
    flex-shrink: 0;
    background-color: var(--surface);
    overflow: hidden;
  }

  .cart-drawer__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer__item-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__item-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .cart-drawer__item-title {
    font-size: 1.125rem;
    line-height: 1.2;
    color: var(--foreground);
    transition: color 0.3s ease;
    flex: 1;
  }

  .cart-drawer__item-title:hover {
    color: var(--primary);
  }

  .cart-drawer__item-line-price {
    flex-shrink: 0;
    font-size: 0.875rem;
    color: var(--foreground);
    white-space: nowrap;
    padding-top: 0.25rem;
  }

  .cart-drawer__item-volume {
    margin-top: 0.4rem;
    font-size: 0.6875rem;
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .cart-drawer__item-unit-pricing {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--foreground);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .cart-drawer__item-compare {
    color: var(--muted-foreground);
    text-decoration: line-through;
    font-size: 0.75rem;
  }

  .cart-drawer__item-controls {
    margin-top: 0.875rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cart-drawer__qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
  }

  .cart-drawer__qty-btn {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    color: var(--foreground);
    transition: color 0.3s ease;
  }

  .cart-drawer__qty-btn:hover {
    color: var(--primary);
  }

  .cart-drawer__qty-value {
    width: 2rem;
    text-align: center;
    font-size: 0.8125rem;
  }

  .cart-drawer__item-remove {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    color: var(--muted-foreground);
    transition: color 0.3s ease;
  }

  .cart-drawer__item-remove:hover {
    color: var(--primary);
  }

  .cart-drawer__footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 2rem;
  }

  .cart-drawer__gift-options {
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .cart-drawer__gift-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.25rem;
    color: var(--foreground);
    font-size: 0.875rem;
  }

  .cart-drawer__gift-summary::-webkit-details-marker {
    display: none;
  }

  .cart-drawer__gift-summary-label {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cart-drawer__gift-summary-label svg {
    color: var(--primary);
    flex-shrink: 0;
  }

  .cart-drawer__gift-toggle {
    display: inline-flex;
    align-items: center;
    color: var(--foreground);
  }

  .cart-drawer__gift-toggle-vertical {
    transition: opacity 0.3s ease;
  }

  .cart-drawer__gift-options[open] .cart-drawer__gift-toggle-vertical {
    opacity: 0;
  }

  .cart-drawer__gift-message-field {
    margin-top: 0.875rem;
  }

  .cart-drawer__gift-message-field textarea {
    width: 100%;
    padding: 0.75rem 0.875rem;
    font-family: inherit;
    font-size: 0.8125rem;
    line-height: 1.55;
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: 0;
    resize: none;
    color: var(--foreground);
    transition: border-color 0.3s ease;
  }

  .cart-drawer__gift-message-field textarea:focus {
    outline: none;
    border-color: var(--primary);
  }

  .cart-drawer__gift-message-meta {
    margin: 0.375rem 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.6875rem;
    color: color-mix(in oklab, var(--foreground) 55%, transparent);
  }

  .cart-drawer__gift-message-status {
    color: var(--primary);
    transition: opacity 0.3s ease;
  }

  /* === Discount === */
  .cart-drawer__discount {
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .cart-drawer__discount-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.25rem;
    color: var(--foreground);
    font-size: 0.875rem;
  }

  .cart-drawer__discount-summary::-webkit-details-marker {
    display: none;
  }

  .cart-drawer__discount-toggle {
    color: var(--foreground);
    display: inline-flex;
    align-items: center;
  }

  .cart-drawer__discount-toggle-vertical {
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform-origin: center;
  }

  .cart-drawer__discount[open] .cart-drawer__discount-toggle-vertical {
    opacity: 0;
  }

  .cart-drawer__discount-form {
    margin-top: 0.875rem;
    display: flex;
    gap: 0.5rem;
  }

  .cart-drawer__discount-input {
    flex: 1;
    padding: 0.75rem 0.875rem;
    font-family: inherit;
    font-size: 0.875rem;
    background-color: var(--background);
    border: 1px solid var(--border);
    color: var(--foreground);
    border-radius: 0;
    transition: border-color 0.3s ease;
  }

  .cart-drawer__discount-input:focus {
    outline: none;
    border-color: var(--primary);
  }

  .cart-drawer__discount-btn {
    padding: 0 1.25rem;
    border: 0;
    background-color: var(--foreground);
    color: var(--background);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.6875rem;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .cart-drawer__discount-btn:hover,
  .cart-drawer__discount-btn:focus-visible {
    background-color: color-mix(in oklab, var(--foreground) 80%, transparent);
  }

  .cart-drawer__applied-discounts {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    font-size: 0.75rem;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .cart-drawer__discount-error {
    margin: 0.75rem 0 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--destructive);
  }

  .cart-drawer__discount-error[hidden] {
    display: none;
  }

  .cart-drawer__discount-error svg {
    color: var(--destructive);
    flex-shrink: 0;
  }

  /* === Totals === */
  .cart-drawer__totals {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.875rem;
  }

  .cart-drawer__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    color: color-mix(in oklab, var(--foreground) 80%, transparent);
  }

  .cart-drawer__row--total {
    color: var(--foreground);
  }

  .cart-drawer__total-amount {
    font-size: 1.5rem;
    color: var(--primary);
  }

  .cart-drawer__checkout {
    display: block;
    width: 100%;
    margin-top: 1.5rem;
    padding: 1rem 2rem;
    background-color: var(--cta-bg);
    color: var(--cta-fg);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.75rem;
    font-weight: 700;
    transition: background-color 0.3s ease;
  }

  .cart-drawer__checkout:hover {
    background-color: var(--cta-bg-hover);
  }

  .cart-drawer__continue {
    display: block;
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: color-mix(in oklab, var(--foreground) 70%, transparent);
    transition: color 0.3s ease;
  }

  .cart-drawer__continue:hover {
    color: var(--primary);
  }
  /* === Line details, savings === */
  .cart-drawer__item-details {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--muted-foreground);
  }

  .cart-drawer__item-details--bundle li::before {
    content: "2␀a0";
  }

  .cart-drawer__item-saved {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--primary);
  }

  /* === Reward progress === */
  .cart-progress {
    padding: 0.875rem 2rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .cart-progress__message {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: center;
    color: var(--foreground);
  }

  .cart-progress__track {
    height: 6px;
    border-radius: 999px;
    background-color: var(--surface, #f1f1f1);
    overflow: hidden;
  }

  .cart-progress__fill {
    display: block;
    height: 100%;
    background-color: var(--primary);
    transform: scaleX(var(--progress, 0));
    transform-origin: left center;
    transition: transform 0.4s ease;
  }

  /* === Upsells === */
  .cart-upsells-slot {
    min-height: 13rem;
    padding: 1.25rem 0 1.5rem;
  }

  .cart-upsells-slot[hidden] {
    display: none;
  }

  /* === Dispatch timer === */
  .cart-drawer__dispatch {
    margin: 1rem 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--foreground);
    text-align: center;
  }

  .cart-drawer__dispatch[hidden] {
    display: none;
  }

  .cart-drawer__dispatch svg {
    flex-shrink: 0;
    color: var(--primary);
  }

  .cart-drawer__dispatch strong {
    font-variant-numeric: tabular-nums;
  }

  /* === Trust row === */
  .cart-drawer__trust {
    margin: 0.75rem 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--muted-foreground);
    text-align: center;
  }

  .cart-drawer__trust svg {
    flex-shrink: 0;
    color: var(--primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-progress__fill {
      transition: none;
    }
  }
{% endstylesheet %}
