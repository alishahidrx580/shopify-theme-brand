{% doc %}
  Renders CollectionPage, ItemList and BreadcrumbList JSON-LD for a collection page.

  The ItemList is capped at 24 products. Listing all 133 products of a large
  collection would add significant weight to an already heavy page, and
  search engines only need enough of the list to understand the page type
  and its leading items.

  @param {collection} collection - The collection to describe
  @param {number} [limit] - How many products to list, default 24

  @example
  {% render 'schema-collection', collection: collection %}
  {% render 'schema-collection', collection: collection, limit: 12 %}
{% enddoc %}

{%- liquid
  assign item_limit = limit | default: 24
  assign description = collection.description | strip_html | strip_newlines | strip | truncate: 500
-%}

{%- if collection != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": {{ shop.url | append: collection.url | append: '#collection' | json }},
      "name": {{ collection.title | json }},
      "url": {{ shop.url | append: collection.url | json }}
      {%- if description != blank -%}
        ,"description": {{ description | json }}
      {%- endif -%}
      {%- if collection.image != blank -%}
        ,"image": {{ collection.image | image_url: width: 1200 | prepend: 'https:' | json }}
      {%- endif -%}
      ,"isPartOf": { "@id": {{ shop.url | append: '/#website' | json }} }
      {%- if collection.products_count > 0 -%}
        ,"mainEntity": {
          "@type": "ItemList",
          "numberOfItems": {{ collection.products_count }},
          "itemListElement": [
            {%- for item in collection.products limit: item_limit -%}
              {
                "@type": "ListItem",
                "position": {{ forloop.index }},
                "name": {{ item.title | json }},
                "url": {{ shop.url | append: item.url | json }}
              }
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
      {%- endif -%}
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ shop.url | append: collection.url | json }}
        }
      ]
    }
  </script>
{%- endif -%}
