<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Apply theme before paint to avoid FOUC. Light is the default; %}
    {% # dark is opt-in only — applied when the visitor has chosen it. %}
    <script>
      (function () {
        try {
          var theme = localStorage.getItem('cham-theme') === 'dark' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    {% # Favicon %}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="icon" type="image/png" sizes="16x16" href="{{ settings.favicon | image_url: width: 16, height: 16 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {% # Design tokens — oklch palette + typography vars %}
    {% render 'css-variables' %}

    {% # Arimo: free metric-compatible Helvetica clone (Dermalogica uses Helvetica LT Pro) %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    >
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    >

    {% # Critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

  {% # Polish layer — motion tokens + card/CTA micro-interactions %}
  {{ 'polish.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'polish.js' | asset_url }}" defer></script>

    {% # Reveal-on-scroll module %}
    <script src="{{ 'reveal.js' | asset_url }}" defer></script>

    {% # Cart drawer controller %}
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

    {% # Wishlist: card + product hearts, header badge, saved-items drawer %}
    {{ 'wishlist.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'wishlist.js' | asset_url }}" defer></script>

    {% # Social, title, schema.org %}
    {% render 'meta-tags' %}
    
    {% # Yandex Webmaster verification %}
    <meta name="yandex-verification" content="1e79091c41279006" />
 
    {% # Bing Webmaster verification %}
    <meta name="msvalidate.01" content="821EE4864C02599A531DE3041205A0B7" />
   
    {% # Pinterest Domain verification %}
    <meta name="p:domain_verify" content="ce5593d2b86b30d7c75f174f6e501528"/>   
    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#main-content">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main-content" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
  
  {%- comment -%}
    Cart drawer fix + mobile quick-add — added 2026-10-20.
    Fixes: added items not appearing in the drawer; stale line-item keys after a
    cart change (remove/qty silently failing until the page was reloaded);
    lost updates when clicking +/- quickly; full page reload when the cart emptied.
    Also replaces the full-width ADD TO BAG bar on touch devices with a compact
    + button so it stops covering the product photo.
    Pairs with templates/cart.drawer.liquid. Safe to delete this whole block.
  {%- endcomment -%}
  <style>
    .cart-drawer__item[data-removing]{opacity:.45;transform:translateX(6px);pointer-events:none;transition:opacity .18s ease,transform .18s ease}
    .cart-drawer__item[data-loading]{opacity:.6;pointer-events:none}
    .cart-drawer__qty-value{min-width:1.5em;text-align:center;font-variant-numeric:tabular-nums}

    @media (hover: none), (max-width: 749px) {
      .product-card__quick-add {
        inset: auto .5rem .5rem auto !important;
        width: 34px !important;
        height: 34px !important;
        min-width: 0 !important;
        padding: 0 !important;
        gap: 0 !important;
        border-radius: 999px !important;
        background: rgba(255,255,255,.92) !important;
        color: #1a1a1a !important;
        border: 1px solid rgba(0,0,0,.12) !important;
        -webkit-backdrop-filter: blur(6px);
        backdrop-filter: blur(6px);
        opacity: 1 !important;
        transform: none !important;
      }
      .product-card__quick-add:not([data-loading])::after { content: none !important; display: none !important; }
      .product-card__quick-add[data-loading]::after { margin-left: 0 !important; }
      .product-card__quick-add[data-added] { background: #1a1a1a !important; color: #fff !important; border-color: #1a1a1a !important; }
      .product-card__quick-add svg { width: 15px !important; height: 15px !important; }
    }
  </style>
  <script>
  (function () {
    'use strict';
    var drawer = document.querySelector('[data-cart-drawer]');
    if (!drawer || window.__cartFixV2) return;
    window.__cartFixV2 = true;

    var MF = new Intl.NumberFormat('en-PK', { style: 'currency', currency: 'PKR', maximumFractionDigits: 0 });
    function money(c) { return MF.format(Math.round(c) / 100); }

    var state = { cart: null };
    var viewUrl = '/cart?view=drawer';
    var J = { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' };

    var chain = Promise.resolve();
    function queue(fn) { chain = chain.then(fn, fn); return chain; }

    function openDrawer() {
      if (window.CartDrawer && window.CartDrawer.open) { window.CartDrawer.open(); return; }
      drawer.setAttribute('aria-hidden', 'false');
      document.body.setAttribute('data-drawer-open', 'true');
      document.body.style.overflow = 'hidden';
    }

    function setCount(n) {
      if (n === null || n === undefined || n === '') return;
      document.querySelectorAll('[data-cart-count]').forEach(function (el) {
        el.textContent = n;
        el.setAttribute('data-cart-count', n);
      });
    }

    function fetchDoc(url) {
      return fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.text() : ''; })
        .then(function (h) { return new DOMParser().parseFromString(h || '', 'text/html'); });
    }

    var rerendering = null;
    function rerender() {
      if (rerendering) return rerendering;
      rerendering = fetchDoc(viewUrl)
        .then(function (doc) {
          if (!doc.querySelector('.cart-drawer__panel') && viewUrl !== '/cart') {
            viewUrl = '/cart';
            return fetchDoc(viewUrl);
          }
          return doc;
        })
        .then(function (doc) {
          var fresh = doc.querySelector('.cart-drawer__panel');
          var panel = drawer.querySelector('.cart-drawer__panel');
          if (fresh && panel) panel.innerHTML = fresh.innerHTML;
          var marker = doc.querySelector('#cart-count-sync');
          var badge = doc.querySelector('[data-cart-count]');
          if (marker) setCount(marker.getAttribute('data-count'));
          else if (badge) setCount((badge.getAttribute('data-cart-count') || badge.textContent || '').trim());
          state.cart = null;
        })
        .catch(function (e) { console.error('[cart] rerender', e); })
        .then(function () { rerendering = null; });
      return rerendering;
    }

  // CHAM offer rule: one free cream per full set of 3 masks (3 -> 1, 6 -> 2); 4, 5, 7, 8 get none.
  // Runs whenever the mask quantity in the bag changes (add, +/-, remove, any pack).
  var CHAM_CREAM = 67387904458980, chamBusy = false, chamPrev = null;
  function chamFree(n) { return n > 0 && n % 3 === 0 ? n / 3 : 0; }
  function chamBonus(cart) {
    if (chamBusy) return;
    var masks = 0, creams = 0, freeCreams = 0;
    cart.items.forEach(function (it) {
      if (it.handle === 'brightening-face-mask') masks += it.quantity;
      if (it.variant_id === CHAM_CREAM) {
        creams += it.quantity;
        if (it.final_line_price === 0) freeCreams += it.quantity;
      }
    });
    var before = chamPrev;
    chamPrev = masks;
    if (before === null || before === masks) return;
    var target = chamFree(masks);
    if (creams < target) {
      chamBusy = true;
      return addVariant(CHAM_CREAM, target - creams).catch(function () {}).then(function () { chamBusy = false; });
  } else if (Math.max(freeCreams - target, chamFree(before) - target) > 0 && creams > 0) {
    // Remove surplus cream: whatever Shopify is giving free beyond the rule, plus what the old mask count earned.
    var remove = Math.min(creams, Math.max(freeCreams - target, chamFree(before) - target));
    var ups = cart.items.map(function (it) {
      if (it.variant_id !== CHAM_CREAM || it.final_line_price !== 0) return it.quantity;
      var take = Math.min(it.quantity, remove);
      remove -= take;
      return it.quantity - take;
    });
    ups = cart.items.map(function (it, i) {
      if (it.variant_id !== CHAM_CREAM || remove <= 0) return ups[i];
      var take = Math.min(ups[i], remove);
      remove -= take;
      return ups[i] - take;
    });
      chamBusy = true;
      return fetch('/cart/update.js', { method: 'POST', credentials: 'same-origin', headers: J, body: JSON.stringify({ updates: ups }) })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (c) { return c ? paint(c) : sync(); })
        .catch(function () {}).then(function () { chamBusy = false; });
    }
  }
  var chamPaintOrig = paint;
  paint = function (cart) {
    try { if (cart && cart.items) chamBonus(cart); } catch (e) {}
    return chamPaintOrig(cart);
  };
  fetch('/cart.js', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (c) {
    if (chamPrev !== null) return;
    var m = 0;
    c.items.forEach(function (it) { if (it.handle === 'brightening-face-mask') m += it.quantity; });
    chamPrev = m;
  }).catch(function () {});
  var chamRerenderOrig = rerender;
  rerender = function () {
    var p = chamRerenderOrig.apply(this, arguments);
    return Promise.resolve(p).then(function (x) {
      return fetch('/cart.js', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (c) {
        try { return Promise.resolve(chamBonus(c)).then(function () { return x; }); } catch (e) {}
        return x;
      });
    }).catch(function () {});
  };

    function paint(cart) {
      if (!cart || !cart.items) return;
      state.cart = cart;

      var total = drawer.querySelector('.cart-drawer__total-amount');
      if (total) total.textContent = money(cart.total_price);
    var chamTok = (window.__chamTok = (window.__chamTok || 0) + 1);
          fetch('/cart?cb=' + Date.now(), { credentials: 'same-origin' }).then(function (r) { return r.text(); }).then(function (h) {
      var doc = new DOMParser().parseFromString(h, 'text/html');
      if (chamTok !== window.__chamTok) return;
      var src = doc.querySelector('.main-cart__row--saved');
      var row = drawer.querySelector('.cart-drawer__row--saved');
      var totals = drawer.querySelector('.cart-drawer__totals');
      if (src) {
        var val = src.lastElementChild.textContent;
        if (row) { row.lastElementChild.textContent = val; }
        else if (totals) {
          row = document.createElement('div');
          row.className = 'cart-drawer__row cart-drawer__row--saved';
          row.setAttribute('style', 'color:var(--primary);font-weight:600');
          row.innerHTML = '<span>Total savings</span><span></span>';
          row.lastElementChild.textContent = val;
          totals.insertBefore(row, totals.firstChild);
        }
      } else if (row) { row.remove(); }
    }).catch(function () {});
var countText = drawer.querySelector('[data-cart-count-text]');
      if (countText) countText.textContent = cart.item_count > 0 ? '(' + cart.item_count + ')' : '';
      setCount(cart.item_count);

      var items = cart.items.slice();
      var used = items.map(function () { return false; });

      Array.prototype.forEach.call(drawer.querySelectorAll('[data-line-key]'), function (row) {
        var key = row.getAttribute('data-line-key');
        var vid = String(key).split(':')[0];
        var idx = -1;
        items.forEach(function (it, i) { if (idx < 0 && !used[i] && it.key === key) idx = i; });
        if (idx < 0) items.forEach(function (it, i) { if (idx < 0 && !used[i] && String(it.variant_id) === vid) idx = i; });
        if (idx < 0) { row.remove(); return; }
        used[idx] = true;
        var it = items[idx];
        row.setAttribute('data-line-key', it.key);
        row.setAttribute('data-line', idx + 1);
        var q = row.querySelector('.cart-drawer__qty-value');
        if (q) q.textContent = it.quantity;
        var lp = row.querySelector('.cart-drawer__item-line-price');
        if (lp) lp.textContent = money(it.final_line_price);
        row.removeAttribute('data-loading');
        row.removeAttribute('data-removing');
      });

      var orphan = false;
      used.forEach(function (u) { if (!u) orphan = true; });
      var hasList = !!drawer.querySelector('.cart-drawer__items');
      if (orphan || (cart.item_count === 0 && hasList) || (cart.item_count > 0 && !hasList)) return rerender();
    }

    function sync() {
      return fetch('/cart.js', { headers: J, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(paint);
    }

    function resolve(key) {
      var c = state.cart;
      if (!c || !c.items) return key;
      var i, vid = String(key).split(':')[0];
      for (i = 0; i < c.items.length; i++) if (c.items[i].key === key) return key;
      for (i = 0; i < c.items.length; i++) if (String(c.items[i].variant_id) === vid) return c.items[i].key;
      return key;
    }

    function post(key, qty) {
      return fetch('/cart/change.js', {
        method: 'POST', credentials: 'same-origin', headers: J,
        body: JSON.stringify({ id: key, quantity: qty })
      }).then(function (r) { return r.ok ? r.json() : null; });
    }

    var pending = Object.create(null);

    function currentQty(k) {
      if (k in pending) return pending[k];
      var sel = window.CSS && CSS.escape ? CSS.escape(k) : k;
      var r = drawer.querySelector('[data-line-key="' + sel + '"]');
      if (!r) return 0;
      var v = r.querySelector('.cart-drawer__qty-value');
      return parseInt(v && v.textContent, 10) || 0;
    }

    function changeLine(key, qty) {
      pending[key] = qty;
      return queue(function () {
        var target = pending[key];
        if (target === undefined) return;
        delete pending[key];
        var k = resolve(key);
        return post(k, target).then(function (cart) {
          if (cart) return paint(cart);
          return sync().then(function () {
            var k2 = resolve(key);
            if (k2 === k) return;
            return post(k2, target).then(function (c2) { return c2 ? paint(c2) : sync(); });
          });
        }).catch(function (e) { console.error('[cart] change', e); return sync(); });
      });
    }

    function addVariant(id, qty) {
      return queue(function () {
        return fetch('/cart/add.js', {
          method: 'POST', credentials: 'same-origin', headers: J,
          body: JSON.stringify({ id: id, quantity: qty || 1 })
        })
          .then(function (r) {
            return r.json().then(function (d) {
              if (!r.ok) throw new Error(d.description || d.message || 'add failed');
              return d;
            });
          })
          .then(function () { return rerender(); });
      });
    }

    function submitForm(btn, form) {
      if (!btn) return;
      var sec = btn.closest && btn.closest('[data-product-section]');
      form = form || (sec && sec.querySelector('[data-product-form]')) || document.querySelector('[data-product-form]');
      if (!form || btn.disabled) return;
      var buyNow = btn.hasAttribute('data-buy-now');
      var fd = new FormData(form);
      btn.setAttribute('data-loading', 'true');
      queue(function () {
        return fetch('/cart/add.js', {
          method: 'POST', body: fd, credentials: 'same-origin',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
          .then(function (r) {
            return r.json().then(function (d) {
              if (!r.ok) throw new Error(d.description || 'add failed');
              return d;
            });
          })
          .then(function () {
        if (buyNow) { return rerender().then(function () { window.location.assign('/checkout'); }); }
            openDrawer();
            return rerender().then(function () { btn.removeAttribute('data-loading'); });
          })
          .catch(function (e) {
            console.error('[cart] add', e);
            btn.removeAttribute('data-loading');
            try { form.submit(); } catch (x) {}
          });
      });
    }

    document.addEventListener('click', function (e) {
      if (!e.target.closest) return;
      var qa = e.target.closest('[data-quick-add]');
      if (qa) {
        e.preventDefault(); e.stopImmediatePropagation();
        if (qa.hasAttribute('data-loading')) return;
        var id = qa.getAttribute('data-variant-id');
        if (!id) return;
        qa.setAttribute('data-loading', 'true');
        qa.disabled = true;
        openDrawer();
        addVariant(id, 1).then(function () {
          qa.removeAttribute('data-loading');
          qa.disabled = false;
          qa.setAttribute('data-added', 'true');
          setTimeout(function () { qa.removeAttribute('data-added'); }, 1500);
        }, function () {
          qa.removeAttribute('data-loading');
          qa.disabled = false;
        });
        return;
      }
      var hit = e.target.closest('[data-cart-qty]') || e.target.closest('[data-cart-remove]');
      if (hit && drawer.contains(hit)) {
        e.preventDefault(); e.stopImmediatePropagation();
        var row = hit.closest('[data-line-key]');
        if (!row) return;
        var key = row.getAttribute('data-line-key');
        if (!key) return;
        var target;
        if (hit.hasAttribute('data-cart-remove')) {
          target = 0;
        } else {
          var d = parseInt(hit.getAttribute('data-delta'), 10) || 0;
          target = Math.max(0, currentQty(key) + d);
        }
        if (target === 0) {
          row.setAttribute('data-removing', 'true');
        } else {
          var qv = row.querySelector('.cart-drawer__qty-value');
          if (qv) qv.textContent = target;
        }
        changeLine(key, target);
        return;
      }
      var sticky = e.target.closest('[data-atc-sticky]');
      if (sticky) { e.preventDefault(); e.stopImmediatePropagation(); submitForm(sticky); }
    }, true);

    document.addEventListener('submit', function (e) {
      if (!e.target.closest) return;
      var form = e.target.closest('[data-product-form]');
      if (!form) return;
      e.preventDefault(); e.stopImmediatePropagation();
      submitForm(e.submitter || form.querySelector('[data-atc]'), form);
    }, true);

    function hook() { if (window.CartDrawer) window.CartDrawer.applyCart = function (c) { paint(c); }; }
    hook();
    document.addEventListener('DOMContentLoaded', hook);
    setTimeout(hook, 0);
  })();
  </script>
</body>
</html>
